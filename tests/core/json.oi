use json.{ Json, Arr, Obj, parse, decode }

as[T] :: fn(j: Json) T {
	match j {
		is T => j,
		_ => zero[T](),
	}
}

test! "extension api" {
	src :: r"""{"header": {"version_major": 4}, "classes": [{"name": "Node", "methods": [{"name": "get_name", "hash": 3218959716}]}]}"""
	top :: as[Obj](parse(src) or { :null })
	assert! as[float](as[Obj](top["header"])["version_major"]) == 4.0
	method :: as[Obj](as[Arr](as[Obj](as[Arr](top["classes"])[0])["methods"])[0])
	assert! as[string](method["name"]) == "get_name"
	assert! as[float](method["hash"]) == 3218959716.0
}

test! "escapes" {
	assert! as[string](parse(r""" "a\n\"b\u00e9" """) or { :null }) == "a\n\"bé"
	assert! as[string](parse(r""" "\ud83d\ude00" """) or { :null }) == "😀"
}

test! "malformed" {
	assert! as[string](parse("[1, 2") or { $.message() }) == "expected a comma at 5"
	assert! as[string](parse(r"""{"a": }""") or { $.message() }) == "invalid number at 6"
}

test! "str" {
	src :: r"""{"a":[1,2.5,true,null,"x\ny"]}"""
	assert! (parse(src) or { :null }).str() == src
}

Inner :: struct { name: string, ok: bool }
Outer :: struct { n: int, x: float, inner: Inner, tag: ?string, xs: []int }

test! "decode" {
	src :: r"""{"n": 3, "x": 1.5, "inner": {"name": "a", "ok": true}, "xs": [1, 2], "extra": 0}"""
	out :: decode[Outer](src) or { panic!($.message()) }
	assert! out.n == 3 && out.x == 1.5 && out.inner.name == "a" && out.inner.ok
	assert! out.tag == none && out.xs == [1, 2]
	msg := ""
	decode[Inner](r"""{"ok": true}""") or { msg = $.message(); Inner.{} }
	assert! msg == "missing field name"
	decode[int]("3.5") or { msg = $.message(); 0 }
	assert! msg == "expected int, got 3.5"
}

P[T] :: struct { item: T }
Held :: struct { p: P[Inner] }

test! "decode a generic named like a json type" {
	out :: decode[Held](r"""{"p": {"item": {"name": "a", "ok": true}}}""") or panic!($.message())
	assert! out.p.item.name == "a"
}

Raw :: struct { n: int, rest: Json }

test! "decode keeps a Json field raw" {
	out :: decode[Raw](r"""{"n": 1, "rest": [1, {"a": null}]}""") or panic!($.message())
	assert! out.rest.str() == r"""[1,{"a":null}]"""
}

Defaulted :: struct { n: int = 7, tag: ?string = "t", name: string }

test! "decode fills a missing field from its default" {
	out :: decode[Defaulted](r"""{"name": "a"}""") or panic!($.message())
	assert! out.n == 7 && out.tag == "t" && out.name == "a"
	kept :: decode[Defaulted](r"""{"n": 1, "tag": null, "name": "b"}""") or panic!($.message())
	assert! kept.n == 1 && kept.tag == none
}
