use json.{ Json, Arr, Obj, parse }

as[T] :: fn(j: Json) T {
	match j {
		v @ T => v,
		_ => zero[T](),
	}
}

test! "extension api" {
	# TODO: revisit with `r#""#` style strings
	src :: "{{\"header\": {{\"version_major\": 4}}, \"classes\": [{{\"name\": \"Node\", \"methods\": [{{\"name\": \"get_name\", \"hash\": 3218959716}}]}}]}}"
	top :: as[Obj](parse(src) or { :null })
	assert! as[float](as[Obj](top["header"])["version_major"]) == 4.0
	method :: as[Obj](as[Arr](as[Obj](as[Arr](top["classes"])[0])["methods"])[0])
	assert! as[string](method["name"]) == "get_name"
	assert! as[float](method["hash"]) == 3218959716.0
}

test! "escapes" {
	assert! as[string](parse("\"a\\n\\\"b\\u00e9\"") or { :null }) == "a\n\"bé"
	assert! as[string](parse("\"\\ud83d\\ude00\"") or { :null }) == "😀"
}

test! "malformed" {
	assert! as[string](parse("[1, 2") or { $.message() }) == "expected a comma at 5"
	assert! as[string](parse("{{\"a\": }}") or { $.message() }) == "invalid number at 6"
}

test! "str" {
	src :: "{{\"a\":[1,2.5,true,null,\"x\\ny\"]}}"
	assert! (parse(src) or { :null }).str() == src
}
