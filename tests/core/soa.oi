Vec2 :: struct { x: f32, y: f32 }
Particle :: struct { pos: Vec2, life: f32 }

life :: fn(ps: @soa [4]Particle, i: int) f32 {
	ps[i].life
}

kill :: fn(mut p: Particle) { p.life = 0 }

test! "gather and scatter" {
	ps: @soa [4]Particle
	ps[1] = .{ pos = .{1, 2}, life = 3 }
	assert! ps[1].pos.y == 2
	assert! life(ps, 1) == 3
	assert! ps.life.len == 4
}

test! "dynamic columns grow and iterate" {
	ps: @soa []Particle
	ps <<= Particle.{ pos = .{1, 2}, life = 3 }
	ps << .{ pos = .{4, 5}, life = 6 } << .{ life = 1 }
	assert! ps.len() == 3
	assert! ps.pos[1].x == 4

	total: f32 = 0
	loop p in ps { total += p.life }
	assert! total == 10
	assert! ps[1..3].life[1] == 1
}

test! "builds from an anon array" {
	ps: @soa []Particle = .[ .{ life = 1 } .{ life = 2 } ]
	assert! ps.life[1] == 2
}

test! "writes one column through a row" {
	ps: @soa []Particle = .[ .{ life = 1 } .{ life = 2 } ]
	ps[1].life -= 0.5
	kill(mut ps[0])
	assert! ps.life[0] == 0 && ps.life[1] == 1.5
}
