use math
use math.{Quat, Vec2, Vec3, Vec4}

test! "constants" {
	assert! math.pi > 3.1 && math.pi < 3.2
}

test! "abs" {
	assert! math.abs(4) == 4
	assert! math.abs(-6.9) == 6.9
}

test! "min max" {
	assert! math.min(3, 7) == 3
	assert! math.min(7.2, 3.2) == 3.2
	assert! math.max(3, 7) == 7
	assert! math.max(7.2, 3.2) == 7.2
}

test! "clamp" {
	assert! math.clamp(-1, 0, 10) == 0
	assert! math.clamp(5.2, 0.0, 10.2) == 5.2
	assert! math.clamp(11, 0, 10) == 10
}

test! "roots and rounding" {
	assert! math.abs(math.sqrt(2) - math.sqrt2) < 1e-15
	assert! math.hypot(3, 4) == 5
	assert! math.round(-2.5) == -3 && math.trunc(-2.7) == -2
	assert! math.lerp(0, 10, 0.25) == 2.5
	assert! math.abs(math.atan2(-1, -1) + 3 * math.pi / 4) < 1e-12
	assert! math.abs(math.acos(0.5) - math.pi / 3) < 1e-12
}

test! "vectors" {
	a :: Vec3.{1.0, 2.0, 3.0}
	assert! math.Vec3.{1.0, 2.0, 3.0} == a
	assert! a + a - a * a / a == a && 2.0 * -a / 2.0 == -a
	assert! a.dot(a) == 14.0 && a.cross(.{0.0, 1.0, 0.0}) == Vec3.{-3.0, 0.0, 1.0}
	assert! Vec2.{3.0, 4.0}.normalize() == Vec2.{0.6, 0.8}
	assert! Vec2.{0.0, 2.0}.lerp(Vec2.{4.0, 6.0}, 0.5) == Vec2.{2.0, 4.0}
	b :: Vec2[i33].{3, 4}
	assert! b.length_squared() == 25 && b.length() == 5.0 && b * i33.(2) == b + b
	assert! 2 * Vec4[int].{1, 2, 3, 4} == Vec4[int].{2, 4, 6, 8}
}

test! "quaternions" {
	i :: Quat.{1.0, 0.0, 0.0, 0.0}
	j :: Quat.{0.0, 1.0, 0.0, 0.0}
	assert! i * j == Quat.{0.0, 0.0, 1.0, 0.0} && j * i == (i * j).conj()
	q :: Quat.from_axis_angle(Vec3.{0.0, 0.0, 1.0}, math.pi / 2.0)
	v :: q * Vec3.{1.0, 0.0, 0.0}
	assert! (v - Vec3.{0.0, 1.0, 0.0}).length() < 1e-15
}
