test! "is empty" {
	xs : []int : []
	assert! xs.is_empty()
	assert! ![1, 2, 3].is_empty()
}

test! "first and last" {
	xs : []int : []
	assert! xs.first() == none
	assert! xs.last() == none

	ys := [1, 2, 3]
	assert! ys.first() == ?int.(1)
	assert! ys.last() == ?int.(3)
}

test! "searching" {
	xs := [1, 2, 3]
	assert! xs.contains(2)
	assert! !xs.contains(9)
	assert! xs.index(2) == ?int.(1)
	assert! xs.index(9) == none
}

test! "reverse" {
	assert! [1, 2, 3].reverse() == [3, 2, 1]

	xs : []int : []
	assert! xs.reverse() == []
}

test! "join" {
	assert! [1 2 3].join(", ") == "1, 2, 3"
	assert! ["a" "b" "c"].join("-") == "a-b-c"

	xs : []int : []
	assert! xs.join(",") == ""
}

test! "map, filter and friends" {
	xs := [1 2 3 4]
	k := 10
	big := xs.filter({ $ > 2 }).map { $ * k }
	assert! big == [30 40]
	assert! xs.map(fn(x) { "{x}" }) == ["1" "2" "3" "4"]
	assert! xs.any({ $ == 3 }) && !xs.any({ $ > 4 })
	assert! xs.all({ $ > 0 }) && !xs.all({ $ > 1 })
	assert! xs.find({ $ % 2 == 0 }) == ?int.(2)
	assert! xs.find({ $ > 4 }) == none
}

test! "lazy iterator adapters" {
	xs := [1 2 3 4 5 6]
	evens := xs.iter().filter({ $ % 2 == 0 }).map({ $ * 10 }).collect()
	assert! evens == [20 40 60]
	squares := loop v in (0..).map({ $ * $ }) { if v > 100 do break; v }
	assert! squares.len() == 11 && squares.last() == ?int.(100)
	assert! (0..10).any({ $ == 3 }) && !(0..10).all({ $ < 5 })
	assert! xs.iter().find({ $ > 4 }) == ?int.(5)
}
