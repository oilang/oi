Perm :: enum { read write exec }

test! "sets" {
	a: [int]() = .[1 2 3]
	b: [int]() = .[2 3 4]
	assert! 1 in a && !(4 in a)
	u := a | b
	assert! u.len() == 4 && 4 in u
	i := a & b
	assert! i.len() == 2 && 2 in i && !(1 in i)
	d := a - b
	assert! d.len() == 1 && 1 in d
	assert! (loop k in d do k) == [1]
}

test! "subsets" {
	a: [int]() = .[1 2]
	b: [int]() = .[1 2 3]
	assert! a <= b && a < b && b > a && a <= a && !(a < a)
	assert! !(a <= .[3]) && !(a >= .[3])
	p: [Perm]() = .[.read]
	q: [Perm]() = .[.read .exec]
	assert! p < q && q >= p && !(p <= .[.write]) && !(p > .[.write])
}

test! "enum sets" {
	p: [Perm]() = .[.read .exec]
	q: [Perm]() = .[.write .exec]
	assert! .exec in p && !(.write in p)
	assert! (p | q).len() == 3 && (p & q).collect() == [.exec]
	assert! (loop e in p - q do e) == [.read]
	assert! p.str() == "{{.read .exec}}"
	assert! (u64.(p) == 0b101)
}

Status :: enum { ok = 200 missing = 404 }

test! "holy (get it?) enum sets" {
	s: [Status]() = .[.ok]
	assert! .ok in s && !(.missing in s) && (s | .[.missing]).len() == 2 && u64.(s | .[.missing]) == 0b11
}

Quad :: struct { deg: int }

Quad : Ordinal < {
	count :: 4
	index :: fn(self) int do self.deg / 90
	from_index :: fn(i: int) ?Quad { if i < 4 { Quad.{ i * 90 } } else { none } }
}

test! "ordinal sets" {
	b: [bool]() = .[true]
	q: [Quad]() = .[Quad.{90} Quad.{270}]
	assert! true in b && !(false in b)
	assert! Quad.{270} in q && !(Quad.{0} in q) && (loop x in q do x.deg) == [90 270]
	r: [rune]() = .['a' '☃']
	assert! '☃' in r && !('b' in r)
	i: [i8]() = .[-128 127]
	assert! -128 in i && !(0 in i) && (!i).len() == 254 && (loop x in i do x) == [-128 127]
	assert! b.str() == "{{true}}" && i.str() == "{{-128 127}}"
}

Wide :: enum { v0 v1 v2 v3 v4 v5 v6 v7 v8 v9 v10 v11 v12 v13 v14 v15 v16 v17 v18 v19 v20 v21 v22 v23 v24 v25 v26 v27 v28 v29 v30 v31 v32 v33 v34 v35 v36 v37 v38 v39 v40 v41 v42 v43 v44 v45 v46 v47 v48 v49 v50 v51 v52 v53 v54 v55 v56 v57 v58 v59 v60 v61 v62 v63 v64 v65 v66 v67 v68 v69 }

test! "enum sets past 64 variants" {
	s: [Wide]() = .[.v1 .v69]
	assert! .v69 in s && !(.v5 in s) && (s | .[.v65]).len() == 3 && (s - .[.v1]).str() == "{{.v69}}" && (!s).len() == 68
}

test! "enum set insert" {
	s: [Perm]() = .[]
	s[.write] = ()
	assert! .write in s && s.len() == 1
}
