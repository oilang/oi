use rand

test! "seeding replays the sequence" {
	rand.seed(1)
	a :: [ rand.int() rand.int() rand.int() ]
	f :: rand.float()
	n :: rand.range(3, 8)

	rand.seed(1)
	assert! [ rand.int() rand.int() rand.int() ] == a
	assert! rand.float() == f
	assert! rand.range(3, 8) == n
	assert! f >= 0.0 && f < 1.0 && n >= 3 && n < 8
}

test! "a hooked generator replaces the default" {
	fixed :: @c fn(data: ptr) u64 { 7 }
	ctx :: .{ ..ctx, rand = Rng.{ proc = fixed, data = ptr(0) } }
	assert! rand.int() == 7
}
