test! "bounds" {
	assert! int.max == 9223372036854775807
	assert! int.min == -int.max - 1
	assert! float.max > 0.0
	assert! float.min < 0.0
	assert! float.epsilon > 0.0
}

test! "nan and inf" {
	assert! (0.0 / 0.0).is_nan()
	assert! nan.is_nan()
	assert! !(1.0).is_nan()
	assert! (1.0 / 0.0).is_inf()
	assert! !(1.0).is_inf()
}
