use encoding.base64.{ encode }
use hash.{ sha1 }

hex :: fn(s: string) string {
	digits :: "0123456789abcdef"
	out: []u8 = []
	loop i in 0..s.len() {
		out << digits[int.(s[i]) >> 4]
		out << digits[int.(s[i]) & 15]
	}
	string.(out)
}

test! "rfc 3174 vectors" {
	assert! hex(sha1("abc")) == "a9993e364706816aba3e25717850c26c9cd0d89d"
	assert! hex(sha1("")) == "da39a3ee5e6b4b0d3255bfef95601890afd80709"
}

test! "rfc 6455 accept key" {
	assert! encode(sha1("dGhlIHNhbXBsZSBub25jZQ==258EAFA5-E914-47DA-95CA-C5AB0DC85B11")) == "s3pPLMBiTxaQ9kYGzzhZRbK+xOo="
}
