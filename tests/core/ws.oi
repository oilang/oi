use net.ws
use net
use hash
use encoding.base64

test! "echo, ping and close" {
	# a fixed generator makes the key and the "ZZZZ" mask known, so kernel buffers stand in for a server thread
	ctx :: .{ ..ctx, rand = Rng.{ proc = @c fn(data: ptr) u64 { 90 }, data = ptr.(0) } }
	key :: base64.encode("ZZZZZZZZZZZZZZZZ")
	accept :: base64.encode(hash.sha1(key + "258EAFA5-E914-47DA-95CA-C5AB0DC85B11"))
	listener :: net.listen(0) or panic!("listen failed")
	client :: net.connect("localhost", listener.port()) or panic!("connect failed")
	server :: listener.accept() or panic!("accept failed")

	# a ping between the two fragments of a 200 byte echo
	text :: (loop _ in 0..100 do "oi").join("")
	echo :: string.([u8.(1) 126 0 150]) + text[..150] + string.([u8.(0x89) 0 0x80 50]) + text[150..]
	server.write("HTTP/1.1 101 OK\r\nSec-Websocket-Accept: {accept}\r\n\r\n{echo}") or panic!("write failed")
	socket := ws.connect(client, "localhost", "/") or panic!("upgrade failed")
	message :: socket.recv() or panic!("recv failed")
	assert! message.data == text && !message.binary
	socket.send(text, false) or panic!("send failed")
	socket.close()

	# masked, "oi" is "53" and close code 1000 is "Y\xb2"
	pong :: string.([u8.(0x8a) 0x80]) + "ZZZZ"
	sent :: string.([u8.(0x81) 0xfe 0 200]) + "ZZZZ" + (loop _ in 0..100 do "53").join("")
	closing :: string.([u8.(0x88) 0x82]) + "ZZZZY" + string.([u8.(0xb2)])
	got :: server.read() or panic!("read failed")
	assert! got.contains("Sec-WebSocket-Key: {key}\r\n") && got.ends_with(pong + sent + closing)
	listener.close()
}
