test! "is empty" {
	assert! "".is_empty()
	assert! !"hi".is_empty()
}

test! "first and last" {
	assert! "hi there".first() == "h"
	assert! "hi there".first(4) == "hi t"
	assert! "hi there".last() == "e"
	assert! "hi there".last(4) == "here"
}

test! "searching" {
	assert! "hello".contains("hell")
	assert! !"hello".contains("xyz")
	assert! "hello".starts_with("he")
	assert! !"hello".starts_with("lo")
	assert! "hello".ends_with("lo")
	assert! !"hello".ends_with("he")
}

test! "casing" {
	assert! "Hi There!".upper() == "HI THERE!"
	assert! "Hi There!".lower() == "hi there!"
}

test! "trim" {
	assert! "  pad\t\n".trim() == "pad"
	assert! "".trim() == ""
}

test! "replace" {
	assert! "a-b-c".replace("-", "+") == "a+b+c"
	assert! "aaa".replace("aa", "b") == "ba"
	assert! "abc".replace("", "x") == "abc"
}

test! "split" {
	assert! "a,b,,c".split(",") == ["a", "b", "", "c"]
	assert! "abc".split("") == ["abc"]
}

test! "parsing" {
	assert! (i8.try_from("-42") or i8.(0)) == i8.(-42)
	assert! (u8.try_from("300") or u8.(1)) == u8.(1)
	assert! (f32.try_from("-2.5") or f32.(0)) == f32.(-2.5)
	assert! (float.try_from("2.") or 0.5) == 0.5
	assert! (int.try_from("4x") or { assert! $.input == "4x"; 0 }) == 0
}

test! "runes" {
	snow : rune : '\u{2603}'
	assert! snow.bytes() == [ u8.(0xe2), u8.(0x98), u8.(0x83) ]

	# one rune of each encoded width
	s :: "a\u{e9}\u{2603}\u{1F600}"
	assert! s.len == 10
	assert! s.runes().len == 4
	assert! s.runes()[2] == snow
	assert! s.runes().join("") == s

	out: []rune
	loop r in s { out << r }
	assert! out == s.runes()
}

test! "string16" {
	s :: string16.("hé😀")
	assert! s.len() == 4
	assert! s.0 == [104 233 0xd83d 0xde00]
	assert! s.str() == "hé😀"
	assert! (loop r in s do r).len == 3
}
