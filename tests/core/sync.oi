use sync

Job :: struct { id: int }

## move-only
Done :: struct { n: int }
Done : Drop < { drop :: fn(mut self) {} }
Done : sync.Waitable[int] < { wait :: fn(move self) int { self.n } }

test! "threads and chans" {
	ch := sync.Chan[Job].{ cap = 2 }
	t := sync.spawn! {
		sum := 0
		loop j in ch { sum += j.id }
		sum
	}

	loop i in 0..5 { ch <- Job.{ id = i } or panic!("closed") }
	ch.close()
	assert! t.wait() == 10

	failed := false
	ch <- Job.{ id = 0 } or { failed = true }
	assert! failed
}

test! "spawn captures are unshared" {
	xs := [1 2]
	ch := sync.Chan[int].{}
	t := sync.spawn! {
		_ := <-ch
		xs[0]
	}
	xs[0] = 100
	ch <- 0 or panic!("closed")
	assert! t.wait() == 1
}

test! "wait on many" {
	ts := loop i in 0..4 do sync.spawn! i * i
	assert! ts.wait() == [0 1 4 9]
	assert! [Done.{ n = 1 }, Done.{ n = 2 }].wait() == [1 2]
}

test! "chan copies share a queue" {
	ch := sync.Chan[Job].{}
	{
		c := ch
		c <- Job.{ id = 7 } or panic!("closed")
	}
	assert! (ch.recv() or panic!("empty")).id == 7
}

test! "try, within and closed" {
	ch := sync.Chan[int].{ cap = 1 }
	assert! ch.recv_within(1.ms()) == none

	ch.try_send(1) or panic!("full")
	failed := false
	ch.try_send(2) or { failed = true }
	ch.close()
	assert! failed && ch.closed() && ch.try_recv() == 1
}

test! "group wait" {
	g := sync.Group[int].{}
	loop i in 0..4 do g.add(sync.spawn! i * i)
	assert! g.wait() == [0 1 4 9]
}

test! "group members add" {
	g := sync.Group[int].{}
	h := g
	g.add(sync.spawn! {
		h.add(sync.spawn! 2)
		1
	})
	assert! g.wait() == [1 2]
}

test! "poll" {
	t := sync.spawn! 2
	s := sync.Signal.{}
	x := loop {
		t.watch(s)
		break t.poll() or { s.sleep(); continue }
	}
	ch := sync.Chan[int].{}
	ch <- 1 or ()
	ch.close()
	a := sync.after(0.ns())
	assert! x == 2 && ch.poll() == ?int.(1) && ch.poll() == ?int.(none) && a.poll() != none
}

test! "select" {
	ch := sync.Chan[int].{ cap = 1 }
	assert! sync.select! { <-ch => "recv", else => "idle" } == "idle"
	assert! sync.select! { ch <- 1 => "sent", else => "full" } == "sent"
	assert! sync.select! { ch <- 2 => "sent", else => "full" } == "full"
	t := sync.spawn! { ch <- 7 or () }
	got := sync.select! { m := <-ch => m or 0, sync.after(1000.ms()) => -1 }
	late := sync.select! { m := <-ch => m or 0, sync.after(10.ms()) => -1 }
	t.wait()
	assert! got == 1 && late == 7
}
