Shape :: enum {
	point
	circle { radius: f64 }
	rect { w: float, h: float }
	triangle(f64, f64, f64)
}

area :: fn(s: Shape) f64 {
	match s {
		.circle.(r) => 3.14159 * r ** 2,
		.rect.(w, h) => w * h,
		else => 0.0,
	}
}

Shape.rect.{ 3.0, 4.0 }
	|> area
	|> assert!($ == 12.0)

shape := Shape.triangle.(3.0, 4.0, 5.0)

match shape {
	.point => {
		print("origin: {()}")
	}
	.circle.(r) => {
		print("circle: {(r,)}")
	}
	.rect.(w, h) => {
		print("rect: {(w h)}")
	}
	t @ .triangle.(a, b, c) => {
		print(t)
	}
}

# expect: triangle.(3.0, 4.0, 5.0)
