## A friendly animal.
Animal :: trait {
	name: string
	greeting: string = "hello"

	greet :: fn(self) string {
		"{self.name} says {self.greeting}!"
	}
}

## Kitty cat.
Cat :: struct {
	name: string
	greeting: string = "meow"
}

Cat :< Animal

## Little pupper.
Dog :: struct {
	name: string
	greeting := "woof"
}

Dog :< {
	walk :: fn(self) {}
}

Dog : Animal < {
	greet :: {
		"{self.name} the doggo says {self.greeting}!"
	}
}

# A... rock?
Rock :: struct {}

# Rocks are people, too.
Rock : Animal < {
	name :: "foo"
}

cat := Cat.{
	name = "Jerry"
}
cat.greet() |> print
# expect: Jerry says meow!

terry := Dog.{
	name = "Terry"
}
terry.greet() |> print
# expect: Terry the doggo says woof!

larry := Dog.{
	name = "Larry"
	greeting = "bark"
}
larry.greet() |> print
# expect: Larry the doggo says bark!
