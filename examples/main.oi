## comments

# Single line comments
# (can be stacked)

#{ Block comments
	#{ (can be nested) }#
}#

## Doc comments.
##
## # support markdown
## ```
## # code block language defaults to Oi
## ```

## Main entrypoint.
##
## Called by Oi if present.
main :: fn() {
	## primatives

	bull := true
	str : string
	integer :: 1337
	float :: 69.420
	atm :: :adam

	bull = false
	str = "string"

	print(2.0 + 1.2)
	# expect: 3.2
}
