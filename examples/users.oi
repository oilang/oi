Status :: enum {
	offline
	online
	away
}

User :: struct {
	name: string
	status: Status
}

badge :: fn(u: User) string {
	match u.status {
		.online => "🟢 {u.name}",
		.away => "🟡 {u.name}",
		.offline => "⚫ {u.name}",
	}
}

User :< {
	create :: fn(name: string) Self {
		return User.{ name }
	}

	greet :: fn(self) string {
		match self.status {
			.online => "Welcome back, {self.name}!",
			.away => "See you soon, {self.name}.",
			.offline => "Goodbye, {self.name}.",
		}
	}
}

user := User.create(
	"ur_mom_lolol"
)
user.status = .online

badge(user) |> print
# expect: 🟢 ur_mom_lolol

user.greet()
# expect: Welcome back, ur_mom_lolol!
