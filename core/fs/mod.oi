module fs

use rt
use libc

check :: fn(ok: bool, what: string, path: Path) ! {
	if !ok do return error("cannot {what} {path}")
}

## Read a file's contents as raw bytes.
pub read_bytes :: fn(path: Path) ![]u8 {
	f := unsafe libc.fopen(path.cstr(), "rb")
	check(!f.is_null(), "open", path)?

	out: []u8
	loop {
		c := unsafe libc.fgetc(f)
		if c < 0 do break
		out << u8.(c)
	}
	unsafe libc.fclose(f)

	out
}

## Read a file's contents as a string.
pub read :: fn(path: Path) !string {
	bytes := read_bytes(path)?
	string.(bytes)
}

## Write to a file, replacing its contents.
pub write :: fn(path: Path, s: string) ! {
	spill(path, s, "wb")
}

## Append to a file, creating it if needed.
pub append :: fn(path: Path, s: string) ! {
	spill(path, s, "ab")
}

spill :: fn(path: Path, s: string, mode: cstr) ! {
	f := unsafe libc.fopen(path.cstr(), mode)
	check(!f.is_null(), "open", path)?

	n :: unsafe libc.fwrite(s.ptr, 1, usize.(s.len()), f)
	_ := unsafe libc.fclose(f)

	if int.(n) != s.len() {
		return error("short write to {path}")
	}
}

## Whether a file or directory exists.
pub exists :: fn(path: Path) bool {
	unsafe libc.access(path.cstr(), 0) == 0
}

## Delete a file or empty directory.
pub remove :: fn(path: Path) ! {
	check(unsafe libc.remove(path.cstr()) == 0, "remove", path)?
}

## Create a directory.
pub mkdir :: fn(path: Path) ! {
	check(unsafe libc.mkdir(path.cstr(), 0o755) == 0, "create", path)?
}

## Get list of entries in a directory.
pub list :: fn(path: Path) ![]string {
	d := unsafe libc.opendir(path.cstr())
	check(!d.is_null(), "open", path)?

	out: []string
	loop {
		e := unsafe libc.readdir(d)
		if e.is_null() do break

		name :: unsafe rt.oi_dirent_name(e).str()
		if name != "." && name != ".." {
			out << name
		}
	}
	_ := unsafe libc.closedir(d)
	out
}
