module core

# operator overloads

# comparison
@lang pub Eq :: trait { eq: fn(self, other: Self) bool }
pub Ordering :: enum { less, equal, greater }
@lang pub PartialCmp :: trait { partial_cmp: fn(self, other: Self) ?Ordering }
@lang pub Cmp : PartialCmp, Eq : trait {
	cmp: fn(self, other: Self) Ordering
	partial_cmp :: fn(self, other: Self) ?Ordering do self.cmp(other)
	eq :: fn(self, other: Self) bool do self.cmp(other) == .equal
}

# arithmetic
@lang pub Neg :: trait {
	neg: fn(self) Self
}
@lang pub Add[Rhs :: Self] :: trait {
	Out :: Self
	add: fn(self; other: Rhs) Out
}
@lang pub Sub[Rhs :: Self] :: trait {
	Out :: Self
	sub: fn(self; other: Rhs) Out
}
@lang pub Mul[Rhs :: Self] :: trait {
	Out :: Self
	mul: fn(self; other: Rhs) Out
}
@lang pub Div[Rhs :: Self] :: trait {
	Out :: Self
	div: fn(self; other: Rhs) Out
}
@lang pub Mod[Rhs :: Self] :: trait {
	Out :: Self
	mod: fn(self; other: Rhs) Out
}
@lang pub Pow[Rhs :: Self] :: trait {
	Out :: Self
	pow: fn(self; other: Rhs) Out
}

# bitwise
@lang pub Not :: trait { not: fn(self) Self }
@lang pub BitAnd[Rhs :: Self] :: trait { bitand: fn(self; other: Rhs) Self }
@lang pub BitOr[Rhs :: Self] :: trait { bitor: fn(self; other: Rhs) Self }
@lang pub BitXor[Rhs :: Self] :: trait { bitxor: fn(self; other: Rhs) Self }
@lang pub Shl[Rhs :: int] :: trait { shl: fn(self; other: Rhs) Self }
@lang pub Shr :: trait { shr: fn(self; other: int) Self }

# membership
@lang pub Contains[T] :: trait { contains: fn(self; v: T) bool }

# indexing
# TODO: handle index oob
@lang pub Index[I, T] :: trait { index: fn(self; i: I) T }
@lang pub IndexAssign[I, T] :: trait { index_assign: fn(mut self; i: I, v: T) }

# channels
@lang pub Send[T] :: trait { send: fn(self; move v: T) !() }
@lang pub Recv[T] :: trait { recv: fn(self) ?T }

## Holds no `^T`, `any`, or fn env, so it can cross threads. Checked structurally.
@lang pub Isolated :: trait {}

## A resource with no implicit drop.
## It must be moved into a consumer, and only its own methods can `discard` it.
@lang pub Linear :: trait {}

## A finite, positive domain.
## Fieldless enums claim it implicitly.
@lang pub Ordinal :: trait {
	count: int
	index: fn(self) int
	from_index: fn(i: int) ?Self
	ord :: fn(self) int { self.index() }
}

## Get the internal value of an ordinal type.
## ex: enum's discriminant, rune's codepoint
pub ord[T: Ordinal] :: fn(x: T) int do x.ord()

bool : Ordinal < {
	count :: 2
	index :: fn(self) int {
		if self { 1 } else { 0 }
	}
	from_index :: fn(i: int) ?bool {
		if i == 0 || i == 1 { i == 1 } else { none }
	}
}

[T: Integer] T : Ordinal < {
	index :: fn(self) int do int.(self) - int.(T.min)
	ord :: fn(self) int do int.(self)
	from_index :: fn(i: int) ?T {
		if i in 0..T.count { T.(i + int.(T.min)) } else { none }
	}
}

rune : Ordinal < {
	count :: 0x110000
	index :: fn(self) int do int.(self)
	from_index :: fn(i: int) ?rune {
		if i in 0..0x110000 { rune.(i) } else { none }
	}
}

## Supports reporting length.
@lang pub Length :: trait { len: fn(self) int }

# iteration
@lang pub Iterator[Item] :: trait {
	next: fn(mut self) ?Item

	## Lazily applies `f` to each item.
	map[U] :: fn(move self; f: fn(Item) U) MapIter[Self, Item, U] {
		.{ self, f }
	}

	## Lazily keeps the items `predicate` holds for.
	filter :: fn(move self; predicate: fn(Item) bool) FilterIter[Self, Item] {
		.{ self, predicate }
	}

	## Drains the remaining items into an array.
	collect :: fn(self) []Item {
		loop x in self do x
	}

	## Whether `predicate` holds for any item.
	any :: fn(self; predicate: fn(Item) bool) bool {
		loop x in self {
			if predicate(x) do return true
		}
		false
	}

	## Whether `predicate` holds for every item.
	all :: fn(self; predicate: fn(Item) bool) bool {
		loop x in self {
			if !predicate(x) do return false
		}
		true
	}

	## First item `predicate` holds for.
	find :: fn(self; predicate: fn(Item) bool) ?Item {
		loop x in self {
			if predicate(x) do break x
		}
	}
}

pub MapIter[I, T, U] :: struct { inner: I, f: fn(T) U }

MapIter[I, T, U] : Iterator[U] < {
	next :: fn(mut self) ?U do self.f(self.inner.next()?)
}

pub FilterIter[I, T] :: struct { inner: I, predicate: fn(T) bool }

FilterIter[I, T] : Iterator[T] < {
	next :: fn(mut self) ?T {
		loop {
			item :: self.inner.next()?
			if self.predicate(item) do return item
		}
	}
}

## A collection walked by cursor, its key unless it claims otherwise.
## `pairs(none)` is the first entry, `pairs(c)` is the one after `c`.
@lang pub Keyed[K, V] :: trait {
	Cursor :: K
	pairs: fn(self; after: ?Cursor) ?(V, Cursor)

	## The key at cursor `at`.
	key :: fn(self; at: Cursor) K { at }

	## Lazy iterator over the items.
	iter :: fn(self) KeyedIter[Self, V] {
		.{ self, none }
	}
}

pub KeyedIter[S, V] :: struct { pub keyed: S, pub after: ?S.Cursor }

KeyedIter[S, V] : Iterator[V] < {
	next :: fn(mut self) ?V {
		(item, at) :: self.keyed.pairs(self.after)?
		self.after = at
		item
	}
}

# rendering

## Accepts written values, like a buffer or an output stream.
@lang pub Write[T :: string] :: trait {
	write: fn(mut self; v: T)
}

## Every type renders, through its own `fmt` or `str`, or the derived printer.
@implicit
@lang pub Display :: trait {
	fmt :: fn(self; mut w: Write) {
		w.write(__render(self))
	}

	str :: fn(self) string {
		b := Buffer.{}
		self.fmt(mut b)
		b.str()
	}
}

[T] T : Display < {}

## Every type debugs, through its own `debug` or the derived printer.
@implicit
@lang pub Debug :: trait {
	debug :: fn(self; mut w: Write) {
		w.write(__repr(self))
	}

	repr :: fn(self) string {
		b := Buffer.{}
		self.debug(mut b)
		b.str()
	}
}

[T] T : Debug < {}

# conversions

pub From[T] :: trait { from: fn(v: T) Self }
pub TryFrom[T] :: trait { try_from: fn(v: T) !Self }

# errors

@lang pub Error :: trait {
	message :: fn(self) string { self.str() }
	cause :: fn(self) ?Error { none }
}

string : Error < {
	message :: fn(self) string { self }
}
atom :< Error

pub Err :: struct {
	pub msg: string,
	pub at: ?Src,
}
Err : Error < {
	message :: fn(self) string { self.msg }
}

## Input that doesn't read as the intended kind.
pub ParseError :: struct {
	pub input: string,
	pub want: string,
}
ParseError : Error < {
	message :: fn(self) string { "`{self.input}` is not a {self.want}" }
}

## A source location, as `src!()` captures it.
@lang pub Src :: struct {
	pub file: string,
	pub line: int,
}
Src :< {
	str :: fn(self) string { "{self.file}:{self.line}" }
}

pub Ctx :: struct {
	Error,
	pub ctx: string,
}
Ctx : Error < {
	message :: fn(self) string { "{self.ctx}: {self.Error.message()}" }
	cause :: fn(self) ?Error { self.Error }
}

# what `error("...")` builds
@lang raise :: fn(msg: string, at: Src) Err do Err.{msg, at}

# appended to main's exit line
@lang origin :: fn(e: Error) string {
	err :: Err.(e) or do return ""
	at :: err.at or do return ""
	"  at {at}"
}
