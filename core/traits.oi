module core

# operator overloads

# comparison
pub Eq :: trait { eq: fn(self, other: Self) bool }
pub Ord :: trait { lt: fn(self, other: Self) bool }

# arithmetic
pub Neg :: trait { neg: fn(self) Self }
pub Add :: trait { add: fn(self, other: Self) Self }
pub Sub :: trait { sub: fn(self, other: Self) Self }
pub Mul :: trait { mul: fn(self, other: Self) Self }
pub Div :: trait { div: fn(self, other: Self) Self }
pub Mod :: trait { mod: fn(self, other: Self) Self }
pub Pow :: trait { pow: fn(self, other: Self) Self }

# bitwise
pub Not :: trait { not: fn(self) Self }
pub BitAnd :: trait { bitand: fn(self, other: Self) Self }
pub BitOr :: trait { bitor: fn(self, other: Self) Self }
pub BitXor :: trait { bitxor: fn(self, other: Self) Self }
pub Shl :: trait { shl: fn(self, other: int) Self }
pub Shr :: trait { shr: fn(self, other: int) Self }

# membership
pub Contains[T] :: trait { contains: fn(self, v: T) bool }

# iteration
pub Iterator[Item] :: trait { next: fn(mut self) ?Item }
pub Iterable[Iter] :: trait { iter: fn(self) Iter }

# conversions

pub From[T] :: trait { from: fn(v: T) Self }
pub TryFrom[T] :: trait { try_from: fn(v: T) !Self }

# errors

pub Error :: trait {
	message: fn(self) string
	cause :: fn(self) ?Error { none }
}

string : Error < {
	message :: fn(self) string { self }
}

pub Err :: struct { pub msg: string }
Err : Error < {
	message :: fn(self) string { self.msg }
}
