module core

# operator overloads

# comparison
pub Eq :: trait { eq: fn(self, other: Self) bool }
pub Ord :: trait { lt: fn(self, other: Self) bool }

# arithmetic
pub Neg :: trait { neg: fn(self) Self }
pub Add[Rhs = Self] :: trait { add: fn(self, other: Rhs) Self }
pub Sub[Rhs = Self] :: trait { sub: fn(self, other: Rhs) Self }
pub Mul[Rhs = Self] :: trait { mul: fn(self, other: Rhs) Self }
pub Div[Rhs = Self] :: trait { div: fn(self, other: Rhs) Self }
pub Mod[Rhs = Self] :: trait { mod: fn(self, other: Rhs) Self }
pub Pow[Rhs = Self] :: trait { pow: fn(self, other: Rhs) Self }

# bitwise
pub Not :: trait { not: fn(self) Self }
pub BitAnd[Rhs = Self] :: trait { bitand: fn(self, other: Rhs) Self }
pub BitOr[Rhs = Self] :: trait { bitor: fn(self, other: Rhs) Self }
pub BitXor[Rhs = Self] :: trait { bitxor: fn(self, other: Rhs) Self }
pub Shl :: trait { shl: fn(self, other: int) Self }
pub Shr :: trait { shr: fn(self, other: int) Self }

# membership
pub Contains[T] :: trait { contains: fn(self, v: T) bool }

# iteration
pub Iterator[Item] :: trait { next: fn(mut self) ?Item }
pub Iterable[Iter] :: trait { iter: fn(self) Iter }

# rendering

## Every type renders, through its own `str` or else the derived printer.
@implicit
pub Str :: trait { str: fn(self) string }

# conversions

pub From[T] :: trait { from: fn(v: T) Self }
pub TryFrom[T] :: trait { try_from: fn(v: T) !Self }

# errors

pub Error :: trait {
	message :: fn(self) string { self.str() }
	cause :: fn(self) ?Error { none }
}

string : Error < {
	message :: fn(self) string { self }
}
atom :< Error

pub Err :: struct {
	pub msg: string,
	pub at: ?Src,
}
Err : Error < {
	message :: fn(self) string { self.msg }
}

## A source location, as `src!()` captures it.
pub Src :: struct {
	pub file: string,
	pub line: int,
}
Src :< {
	str :: fn(self) string { "{self.file}:{self.line}" }
}

pub Ctx :: struct {
	Error,
	pub ctx: string,
}
Ctx : Error < {
	message :: fn(self) string { "{self.ctx}: {self.Error.message()}" }
	cause :: fn(self) ?Error { self.Error }
}

# what `error("...")` builds
raise :: fn(msg: string, at: Src) Err { Err.{msg, at} }

# appended to main's exit line
origin :: fn(e: Error) string {
	err :: Err.(e) or { return "" }
	at :: err.at or { return "" }
	"  at {at}"
}
