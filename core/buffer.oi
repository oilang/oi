module core

## A growable byte buffer.
pub Buffer :: struct { data: []u8 = [] }

Buffer :< {
	pub write :: fn(mut self, s: string) {
		d := self.data
		d << []u8.(s)
		self.data = d
	}

	pub bytes :: fn(self) []u8 {
		self.data
	}

	pub len :: fn(self) int {
		self.data.len
	}

	pub clear :: fn(mut self) {
		self.data = []
	}

	pub str :: fn(self) string {
		string.(self.data)
	}

	pub fmt :: fn(self, mut b: Buffer) {
		b.write(self.str())
	}
}

# TODO: handle index oob
Buffer : Index[int, u8] < {
	index :: fn(self, i: int) u8 { self.data[i] }
}

# TODO: handle index oob
Buffer : IndexAssign[int, u8] < {
	index_assign :: fn(mut self, i: int, v: u8) {
		d := self.data
		d[i] = v
		self.data = d
	}
}
