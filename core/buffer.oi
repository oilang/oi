module core

## A growable byte buffer.
pub Buffer :: struct { data: []u8 = [] }

Buffer :< {
	pub bytes :: fn(self) []u8 {
		self.data
	}

	pub clear :: fn(mut self) {
		self.data = []
	}

	pub str :: fn(self) string {
		string.(self.data)
	}

	pub fmt :: fn(self; mut w: Write) {
		w.write(self.str())
	}
}

Buffer : Write[string] < {
	write :: fn(mut self; s: string) do self.data << []u8.(s)
}

Buffer : Write[rune] < {
	write :: fn(mut self; r: rune) do self.data << r.bytes()
}

Buffer : Write[u8] < {
	write :: fn(mut self; byte: u8) do self.data << byte
}

Buffer : Write[[]u8] < {
	write :: fn(mut self; bytes: []u8) do self.data << bytes
}

# TODO: handle index oob
Buffer : Index[int, u8] < {
	index :: fn(self; i: int) u8 {
		self.data[i]
	}
}

# TODO: handle index oob
Buffer : IndexAssign[int, u8] < {
	index_assign :: fn(mut self; i: int, v: u8) {
		self.data[i] = v
	}
}

Buffer : Length < {
	len :: fn(self) int {
		self.data.len()
	}
}
