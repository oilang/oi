module json

## A JSON value.
pub Json :: :null | bool | float | string | Arr | Obj
pub Arr :: []Json
pub Obj :: [string]Json

## Parse a JSON document.
pub parse :: fn(s: string) !Json {
	p := P.{s = s}
	v := p.value()?
	p.space()
	if p.i < s.len { return error("trailing input at {p.i}") }
	v
}

Json :< {
	## Compact JSON text.
	pub str :: fn(self) string {
		match self {
			:null => "null",
			b @ bool => b.str(),
			f @ float => {
				if f > -1e15 && f < 1e15 && float.(int.(f)) == f {
					int.(f).str()
				} else {
					f.str()
				}
			},
			s @ string => quote(s),
			a @ Arr => {
				parts: []string
				loop v in a {
					parts << v.str()
				}
				"[" + parts.join(",") + "]"
			},
			o @ Obj => {
				parts: []string = []
				loop (k, v) in o { parts << quote(k) + ":" + v.str() }
				"{{" + parts.join(",") + "}}"
			},
		}
	}
}

hex :: "0123456789abcdef"

## Value of a hex digit 0-9a-fA-F.
hex_digit :: fn(c: u8) !int {
	if c >= 48 && c <= 57 { return int.(c) - 48 }
	if c >= 97 && c <= 102 { return int.(c) - 87 }
	if c >= 65 && c <= 70 { return int.(c) - 55 }
	error("invalid hex digit")
}

## Encode a Unicode code point as UTF-8 bytes.
utf8_encode :: fn(cp: int) string {
	if cp < 0x80 { return string.([u8.(cp)]) }
	if cp < 0x800 { return string.([u8.(0xc0 | cp >> 6), u8.(0x80 | cp & 0x3f)]) }
	if cp < 0x10000 {
		return string.([u8.(0xe0 | cp >> 12), u8.(0x80 | cp >> 6 & 0x3f), u8.(0x80 | cp & 0x3f)])
	}
	string.([u8.(0xf0 | cp >> 18), u8.(0x80 | cp >> 12 & 0x3f), u8.(0x80 | cp >> 6 & 0x3f), u8.(0x80 | cp & 0x3f)])
}

## Quote and escape a string.
quote :: fn(s: string) string {
	out := "\""
	loop c in s {
		out += match c {
			34 => "\\\"",
			92 => "\\\\",
			10 => "\\n",
			13 => "\\r",
			9 => "\\t",
			else => if c < 32 {
				n :: int.(c)
				"\\u00" + hex[(n / 16)..(n / 16 + 1)] + hex[(n % 16)..(n % 16 + 1)]
			} else { string.([c]) },
		}
	}
	out + "\""
}

P :: struct { s: string, i: int }

P :< {
	## The byte under the cursor, "" at the end
	at :: fn(self) string {
		if self.i < self.s.len {
			self.s[self.i..self.i + 1]
		} else { "" }
	}

	space :: fn(mut self) {
		loop self.at() != "" && " \t\n\r".contains(self.at()) {
			self.i += 1
		}
	}

	word :: fn(mut self, w: string) ! {
		self.space()
		if !self.s[self.i..].starts_with(w) { return error("expected {w} at {self.i}") }
		self.i += w.len
	}

	value :: fn(mut self) !Json {
		self.space()
		c :: self.at()
		if c == "{{" { return self.obj() }
		if c == "[" { return self.arr() }
		if c == "\"" { return self.str()? }
		if c == "t" { self.word("true")?; return true }
		if c == "f" { self.word("false")?; return false }
		if c == "n" { self.word("null")?; nul : Json : :null; return nul }
		self.num()
	}

	num :: fn(mut self) !Json {
		a :: self.i
		loop self.at() != "" && "+-.eE0123456789".contains(self.at()) { self.i += 1 }
		parse_float(self.s[a..self.i]) or { return error("invalid number at {a}") }
	}

	## Decode 4 hex digits at the cursor into a code point.
	hex4 :: fn(mut self) !int {
		if self.i + 4 > self.s.len { return error("truncated \\u escape at {self.i}") }
		cp := 0
		loop j in 0..4 { cp = cp * 16 + hex_digit(self.s[self.i + j])? }
		self.i += 4
		cp
	}

	str :: fn(mut self) !string {
		self.word("\"")?
		out := ""
		a := self.i

		loop self.at() != "" {
			c :: self.at()
			self.i += 1
			if c != "\"" && c != "\\" { continue }

			out += self.s[a..self.i - 1]
			if c == "\"" { return out }

			e :: self.at()
			self.i += 1

			out += match e {
				"n" => "\n", "t" => "\t", "r" => "\r", "b" => string.([u8.(8)]), "f" => string.([u8.(12)]),
				"\"", "\\", "/" => e,
				"u" => {
					cp := self.hex4()?
					if cp >= 0xd800 && cp <= 0xdbff && self.s[self.i..].starts_with("\\u") {
						self.i += 2
						lo :: self.hex4()?
						cp = 0x10000 + (cp - 0xd800) * 0x400 + (lo - 0xdc00)
					}
					utf8_encode(cp)
				},
				else => { return error("invalid escape at {self.i - 1}") },
			}

			a = self.i
		}
		error("unterminated string")
	}

	arr :: fn(mut self) !Json {
		out: Arr = []
		loop self.more("]")? {
			out << self.value()?
		}
		out
	}

	obj :: fn(mut self) !Json {
		out: Obj = []
		loop self.more("}}")? {
			k :: self.str()?
			self.word(":")?
			out[k] = self.value()?
		}
		out
	}

	## Check whether an item follows a comma.
	more :: fn(mut self, close: string) !bool {
		self.space()
		c :: self.at()
		self.i += 1
		if c == close { return false }
		if c != "," && c != "[" && c != "{{" { return error("expected a comma at {self.i - 1}") }
		self.space()
		if self.at() == close && c != "," { self.i += 1; return false }
		true
	}
}
