module core

[]T :< {
	is_empty :: fn(self) bool {
		self.len() == 0
	}

	first :: fn(self) ?T {
		if self.len() == 0 do return none
		self[0]
	}

	last :: fn(self) ?T {
		if self.len() == 0 do return none
		self[self.len() - 1]
	}

	contains :: fn(self; x: T) bool {
		x in self
	}

	index :: fn(self; x: T) ?int {
		loop i in 0..self.len() {
			if self[i] == x do return i
		}
		none
	}

	## New array with elements in reverse order.
	reverse :: fn(self) []T {
		loop i in 0..self.len() do self[self.len() - 1 - i]
	}

	## New array with `f` applied to each element.
	map[U] :: fn(self; f: fn(T) U) []U {
		loop x in self do f(x)
	}

	## New array of the elements `predicate` holds for.
	filter :: fn(self; predicate: fn(T) bool) []T {
		loop x in self { if !predicate(x) do continue; x }
	}

	## Whether `predicate` holds for any element.
	any :: fn(self; predicate: fn(T) bool) bool {
		loop x in self { if predicate(x) do return true }
		false
	}

	## Whether `predicate` holds for every element.
	all :: fn(self; predicate: fn(T) bool) bool {
		loop x in self { if !predicate(x) do return false }
		true
	}

	## The first element `predicate` holds for.
	find :: fn(self; predicate: fn(T) bool) ?T {
		loop x in self { if predicate(x) do break x }
	}

	## Join elements with `separator`.
	join :: fn(self; separator: string) string {
		out := ""
		loop i in 0..self.len() {
			if i > 0 { out += separator }
			out += self[i].str()
		}
		out
	}
}

## Arrays claim `Keyed` for bounds, loops still index them directly.
[T] []T : Keyed[int, T] < {
	pairs :: fn(self; after: ?int) ?(T, int) {
		i :: (after or -1) + 1
		if i >= self.len() do return none
		(self[i], i)
	}

	## Lazy iterator over the elements.
	iter :: fn(self) ArrayIter[T] { .{ self, 0 } }
}

pub ArrayIter[T] :: struct { items: []T, at: int }

ArrayIter[T] : Iterator[T] < {
	next :: fn(mut self) ?T {
		if self.at == self.items.len() do return none
		self.at += 1
		self.items[self.at - 1]
	}
}

## Maps walk in insertion order and `[E]T` by variant, each entry under its position.
[K]V : Keyed[K, V] < {
	Cursor :: int
	pairs :: fn(self; after: ?int) ?(V, int) {
		at :: (after or -1) + 1
		if at >= self.len() do return none
		(__value_at(self, at), at)
	}
	key :: fn(self; at: int) K { __key_at(self, at) }
}

## Map union, `other` wins on shared keys.
[K]V : BitOr < {
	bitor :: fn(self, other: Self) out: Self {
		loop k in self.keys do out[k] = self[k]
		loop k in other.keys do out[k] = other[k]
		out
	}
}

[K]V : BitAnd < {
	bitand :: fn(self, other: Self) out: Self {
		loop k in self.keys {
			if k in other do out[k] = self[k]
		}
		out
	}
}

[K]V : Sub < {
	sub :: fn(self, other: Self) out: Self {
		loop k in self.keys {
			if !(k in other) do out[k] = self[k]
		}
		out
	}
}

## Treats <, <=, >, >= as subset/superset.
[K]() : PartialCmp < {
	partial_cmp :: fn(self, other: Self) ?Ordering {
		within :: (self - other).len() == 0
		covers :: (other - self).len() == 0
		if within && covers { .equal } else if within { .less } else if covers { .greater } else { none }
	}
}

## Build a set from an array of its keys.
[K]() : From[[]K] < {
	from :: fn(keys: []K) out: Self {
		loop k in keys do out[k] = ()
		out
	}
}

[K]V : Display < {
	fmt :: fn(self; mut w: Write) {
		set :: comp V == ()
		w.write(if set { "{{" } else { "[" })
		sep := ""
		loop k in self.keys {
			w.write(sep)
			k.debug(mut w)
			if !set {
				w.write(" = ")
				self[k].debug(mut w)
			}
			sep = if set { " " } else { ", " }
		}
		w.write(if set { "}}" } else { "]" })
	}
}
