module core

## A set of ordinals, one bit each.
pub Bits[E: Ordinal] :: struct {
	words: [((E.count + 63) / 64)]u64,
}

Bits[E] : From[[]E] < {
	from :: fn(xs: []E) out: Self {
		loop x in xs {
			i :: x.index()
			out.words[i / 64] |= u64.(1) << i % 64
		}
		out
	}
}

Bits[E] : Contains[E] < {
	contains :: fn(self; x: E) bool {
		i :: x.index()
		self.words[i / 64] & u64.(1) << i % 64 != 0
	}
}

Bits[E] : IndexAssign[E, ()] < {
	index_assign :: fn(mut self; x: E, v: ()) {
		i :: x.index()
		self.words[i / 64] |= u64.(1) << i % 64
	}
}

Bits[E] : BitOr < {
	bitor :: fn(self, other: Self) Self {
		.{ self.words | other.words }
	}
}

Bits[E] : BitAnd < {
	bitand :: fn(self, other: Self) Self {
		.{ self.words & other.words }
	}
}

Bits[E] : Sub < {
	sub :: fn(self, other: Self) Self {
		.{ (self.words | other.words) - other.words }
	}
}

## Treats <, <=, >, >= as subset/superset.
Bits[E] : PartialCmp < {
	partial_cmp :: fn(self, other: Self) ?Ordering {
		within :: (self - other).len() == 0
		covers :: (other - self).len() == 0
		if within && covers { .equal } else if within { .less } else if covers { .greater } else { none }
	}
}

Bits[E] : Not < {
	not :: fn(self) out: Self {
		loop i in 0..out.words.len() {
			out.words[i] = !self.words[i]
		}
		if E.count % 64 != 0 {
			out.words[out.words.len() - 1] &= (u64.(1) << E.count % 64) - 1
		}
		out
	}
}

Bits[E] :< {
	## The members of the set, in index order.
	pub collect :: fn(self) []E {
		loop e in self do e
	}
}

Bits[E] : Display < {
	str :: fn(self) string {
		names := loop e in self {
			if E is Integer || type(e) == bool || type(e) == rune { e.str() } else { ".{e}" }
		}
		"{{" + names.join(" ") + "}}"
	}
}

Bits[E] : Length < {
	len :: fn(self) out: int {
		loop _ in self do out += 1
		out
	}
}

BitsIter[E] :: struct { set: Bits[E], at: int }

BitsIter[E] : Iterator[E] < {
	next :: fn(mut self) ?E {
		loop self.at < E.count {
			self.at += 1
			if self.set.words[(self.at - 1) / 64] & u64.(1) << (self.at - 1) % 64 != 0 {
				return E.from_index(self.at - 1)
			}
		}
		none
	}
}

Bits[E] : Iterable[BitsIter[E]] < {
	iter :: fn(self) BitsIter[E] {
		.{ self, 0 }
	}
}
