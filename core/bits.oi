module core

## A set of ordinals, one bit each.
pub Bits[E: Ordinal] :: struct {
	raw: u64,
}

Bits[E] : From[[]E] < {
	from :: fn(xs: []E) out: Self {
		loop x in xs {
			out.raw |= u64.(1) << x.index()
		}
		out
	}
}

Bits[E] : Contains[E] < {
	contains :: fn(self; x: E) bool {
		self.raw & u64.(1) << x.index() != 0
	}
}

Bits[E] : BitOr < {
	bitor :: fn(self, other: Self) Self {
		.{ self.raw | other.raw }
	}
}

Bits[E] : BitAnd < {
	bitand :: fn(self, other: Self) Self {
		.{ self.raw & other.raw }
	}
}

Bits[E] : Sub < {
	sub :: fn(self, other: Self) Self {
		.{ self.raw & !other.raw }
	}
}

Bits[E] :< {
	## The members of the set, in index order.
	pub collect :: fn(self) []E {
		loop i in 0..E.count {
			if self.raw & u64.(1) << i == 0 do continue
			E.from_index(i) or continue
		}
	}
}

Bits[E] : Display < {
	str :: fn(self) string {
		names := loop e in self do ".{e}"
		"{{" + names.join(" ") + "}}"
	}
}

Bits[E] : Length < {
	len :: fn(self) int {
		self.collect().len()
	}
}

BitsIter[E] :: struct { items: []E, at: int }

BitsIter[E] : Iterator[E] < {
	next :: fn(mut self) ?E {
		if self.at == self.items.len() do return none
		self.at += 1
		self.items[self.at - 1]
	}
}

Bits[E] : Iterable[BitsIter[E]] < {
	iter :: fn(self) BitsIter[E] {
		.{ self.collect(), 0 }
	}
}
