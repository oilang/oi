module core

## A set of enum variants, one bit each.
pub Bits[E] :: struct {
	pub raw: u64,
}

Bits[E] : From[[]E] < {
	from :: fn(xs: []E) out: Self {
		loop x in xs {
			out.raw |= u64.(1) << int.(x)
		}
		out
	}
}

Bits[E] : Contains[E] < {
	contains :: fn(self, x: E) bool {
		self.raw & u64.(1) << int.(x) != 0
	}
}

Bits[E] : BitOr < {
	bitor :: fn(self, other: Self) Self {
		.{ self.raw | other.raw }
	}
}

Bits[E] : BitAnd < {
	bitand :: fn(self, other: Self) Self {
		.{ self.raw & other.raw }
	}
}

Bits[E] : Sub < {
	sub :: fn(self, other: Self) Self {
		.{ self.raw & !other.raw }
	}
}
