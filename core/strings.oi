module core

use rt

string :< {
	is_empty :: fn(self) bool {
		self.len == 0
	}

	## First n characters.
	first :: fn(self, n := 1) string {
		if n < 0 { return }
		self[..n]
	}

	## Last n characters.
	last :: fn(self, n := 1) string {
		if n < 0 { return }
		if n > self.len { return self }
		self[(self.len - n)..]
	}

	starts_with :: fn(self, prefix: string) bool {
		prefix.len <= self.len && self[..prefix.len] == prefix
	}

	ends_with :: fn(self, suffix: string) bool {
		suffix.len <= self.len && self[(self.len - suffix.len)..] == suffix
	}

	## Whether the string contains substring `sub`.
	contains :: fn(self, sub: string) bool {
		upper :: self.len - sub.len + 1
		loop i in 0..upper {
			if self[i..(i + sub.len)] == sub { return true }
		}
		false
	}

	## Trim whitespace from either side.
	trim :: fn(self) string {
		a := 0
		b := self.len
		loop a < b && is_space(self[a]) {
			a += 1
		}
		loop b > a && is_space(self[b - 1]) {
			b -= 1
		}
		self[a..b]
	}

	## Return string in uppercase.
	upper :: fn(self) string {
		out: []u8 = []
		loop i in 0..self.len {
			c :: self[i]
			out << if c >= 97 && c <= 122 { c - 32 } else { c }
		}
		string.(out)
	}

	## Return string in lowercase.
	lower :: fn(self) string {
		out: []u8 = []
		loop i in 0..self.len {
			c :: self[i]
			out << if c >= 65 && c <= 90 { c + 32 } else { c }
		}
		string.(out)
	}

	## Replace `from` with `to`.
	replace :: fn(self, from: string, to: string) string {
		if from.len == 0 { return self }

		out: []u8 = []
		i := 0
		loop i < self.len {
			if self[i..].starts_with(from) {
				loop j in 0..to.len {
					out << to[j]
				}
				i += from.len
			} else {
				out << self[i]
				i += 1
			}
		}

		string.(out)
	}

	## Split on `sep`.
	split :: fn(self, sep := "") []string {
		if sep == "" { return [self] }

		out: []string = []
		a := 0
		i := 0
		loop i < self.len {
			if self[i..].starts_with(sep) {
				out << self[a..i]
				i += sep.len
				a = i
			} else {
				i += 1
			}
		}
		out << self[a..]

		out
	}

	## Wrap with given characters.
	wrap :: fn(self, left: string, right: string = left) string {
		left + self + right
	}

	## Convert to a NUL-terminated pointer for C interop.
	cstr :: fn(self) cstr {
		unsafe rt.oi_str_cstr(self)
	}

	## The codepoints of this string, decoded from UTF-8.
	runes :: fn(self) out: []rune {
		loop r in self {
			out << r
		}
		out
	}
}

## Cursor over a string's codepoints.
pub Runes :: struct { s: string, at: int }

Runes : Iterator[rune] < {
	next :: fn(mut self) ?rune {
		if self.at >= self.s.len do return none
		lead :: int.(self.s[self.at])
		n :: match true {
			lead < 0x80 => 1,
			lead < 0xe0 => 2,
			lead < 0xf0 => 3,
			else => 4
		}
		if self.at + n > self.s.len do return none # truncated tail
		c := if n == 1 { lead } else { lead & (0x7f >> n) }
		loop k in 1..n {
			c = (c << 6) | (int.(self.s[self.at + k]) & 0x3f)
		}
		self.at += n
		rune.(c)
	}
}

## Iterating a string walks its codepoints.
string : Iterable[Runes] < {
	iter :: fn(self) Runes { Runes.{ self, 0 } }
}

rune :< {
	## UTF-8 encoding of this codepoint.
	bytes :: fn(self) []u8 {
		c :: int.(self)
		tail :: fn(shift: int) u8 { u8.(0x80 | ((c >> shift) & 0x3f)) }
		if c < 0x80 {
			return [ u8.(c) ]
		}
		if c < 0x800 {
			return [ u8.(0xc0 | (c >> 6)), tail(0) ]
		}
		if c < 0x10000 {
			return [ u8.(0xe0 | (c >> 12)), tail(6), tail(0) ]
		}
		[ u8.(0xf0 | (c >> 18)), tail(12), tail(6), tail(0) ]
	}

	## This codepoint as a one-rune string.
	str :: fn(self) string {
		string.(self.bytes())
	}
}

cstr :< {
	## Copy a C string's bytes into an owned string.
	@unsafe
	str :: fn(self) string {
		unsafe rt.oi_cstr_str(self)
	}
}

## Whether the given character is a space.
is_space :: fn(x: u8) bool {
	x == 32 || (x >= 9 && x <= 13)
}

## Parse an integer of any width.
pub parse_int[T = int] :: fn(s: string) ?T {
	neg :: s.starts_with("-")
	digits[T](if neg { s[1..] } else { s }, neg)
}

## Parse a float of any width.
pub parse_float[T = float] :: fn(s: string) ?T {
	if s.starts_with("-") { return -parse_float[T](s[1..])? }
	loop i in 0..s.len {
		if s[i] == 46 {
			frac :: s[(i + 1)..]
			return digits[T](s[..i], false)? + digits[T](frac, false)? / 10 ** T.(frac.len)
		}
	}
	digits[T](s, false)
}

## Accumulate decimal digits into `T`.
digits[T] :: fn(s: string, neg: bool) ?T {
	if s.len == 0 { return }
	wraps :: T.(1) / T.(2) == 0  # only ints wrap on overflow
	out: T = 0
	loop i in 0..s.len {
		d :: int.(s[i]) - 48
		if d < 0 || d > 9 { return }
		n :: if neg { out * 10 - T.(d) } else { out * 10 + T.(d) }
		if wraps && n / 10 != out { return }
		out = n
	}
	out
}

int : TryFrom[string] < {
	try_from :: fn(s: string) !int {
		parse_int[Self](s) or { return error("`{s}` is not an int") }
	}
}

float : TryFrom[string] < {
	try_from :: fn(s: string) !float {
		parse_float[Self](s) or { return error("`{s}` is not a float") }
	}
}
