module core

## The implicit `ctx` carried by most functions.

use rt

## `Alloc.proc` modes.
pub AllocMode :: enum {
	alloc,
	free,
	# resize,
	free_all = 3,
}

## A C-callable allocator record.
pub Alloc :: struct {
	pub proc: @c fn(data: ptr, mode: AllocMode, size: int, align: int, old: ptr, old_size: int) ptr
	pub data: ptr
}

Alloc :< {
	## Hand back everything allocated so far, for allocators that free everything at once.
	pub free_all :: fn(self) {
		_ := self.proc(self.data, .free_all, 0, 0, ptr(0), 0)
	}
}

## Claimers coerce to `Alloc`.
pub Allocator :: trait {
	alloc: fn(mut self, size: int, align: int) ptr
	free :: fn(mut self, old: ptr, old_size: int) { () }
	free_all :: fn(mut self) { () }
}

# `Alloc.proc` for a claimer `T` behind `data`.
pub alloc_shim[T: Allocator] :: fn(data: ptr, mode: AllocMode, size: int, align: int, old: ptr, old_size: int) ptr {
	match mode {
		.alloc => unsafe T.(data).alloc(size, align),
		.free => {
			unsafe T.(data).free(old, old_size)
			ptr(0)
		},
		.free_all => {
			unsafe T.(data).free_all()
			ptr(0)
		},
	}
}

## The system heap, what the root context allocates from.
## Delegate to it from custom allocators.
pub system_allocator :: fn() Alloc {
	unsafe rt.oi_system_allocator()
}

## A fresh bump arena.
## Allocating is a pointer bump, freeing is a no-op, and `free_all` rewinds.
pub arena :: fn() Alloc {
	c :: chunk(CHUNK)
	a :: raw(24)
	unsafe a.write(Arena.{ first = c, at = c })
	unsafe Arena.(a)
}

CHUNK :: 2 ** 16

# A chunk list. Chunks are never handed back, so `free_all` rewinds to the first and reuses them.
Arena :: struct {
	first: ptr,
	at: ptr,
	used: int,
}

# Straight from the system heap, since `ctx.alloc` may be the arena itself.
raw :: fn(size: int) ptr {
	sys :: system_allocator()
	sys.proc(sys.data, .alloc, size, 8, ptr(0), 0)
}

# A chunk opens with its next chunk and its size.
chunk :: fn(size: int) ptr {
	p :: raw(size + 16)
	unsafe p.offset(8).write(size)
	p
}

Arena : Allocator < {
	alloc :: fn(mut self, size: int, align: int) ptr {
		n :: if size > 0 {
			(size + 7) / 8 * 8
		} else do 8
		loop (self.used + n > unsafe self.at.offset(8).read[int]()) {
			next := unsafe self.at.read[ptr]()
			if next.is_null() {
				next = chunk(if n > CHUNK do n else do CHUNK)
				unsafe self.at.write(next)
			}
			self.at = next
			self.used = 0
		}

		out :: self.at.offset(16 + self.used)
		self.used += n
		i := 0
		loop i < n {
			unsafe out.offset(i).write(0)
			i += 8
		}
		out
	}

	free_all :: fn(mut self) {
		self.at = self.first
		self.used = 0
	}
}

## Log severity, ordered.
pub Level :: enum {
	debug = -1,
	info = 0,
	warn = 1,
	error = 2,
}

## Where `log.info(..)` and friends end up.
pub Logger :: struct {
	pub proc: ?fn(data: ptr, level: Level, msg: string)
	pub level: Level = .info
	pub data: ptr
}

## The root context's logger.
pub default_log :: fn(data: ptr, level: Level, msg: string) {
	eprint("[{level}] {msg}")
}

## A C-callable generator.
pub Rng :: struct {
	pub proc: @c fn(data: ptr) u64
	pub data: ptr
}

pub Context :: struct {
	pub alloc: Alloc
	pub temp: Alloc
	pub log: Logger
	pub panic: fn(msg: string, at: Src)
	pub rand: Rng
	pub thread: int
}
