module core

## The implicit `ctx` carried by most functions.

use rt

# `Allocator.proc` modes.
# TODO: make this an enum, but need to add enums to C ABI first
pub ALLOC :: 0
pub FREE :: 1
pub FREE_ALL :: 3

## A C-callable allocator record.
pub Allocator :: struct {
	pub proc: @c fn(data: ptr, mode: int, size: int, align: int, old: ptr, old_size: int) ptr
	pub data: ptr
}

Allocator :< {
	## Hand back everything allocated so far, for allocators that free everything at once.
	pub free_all :: fn(self) {
		self.proc(self.data, FREE_ALL, 0, 0, ptr(0), 0)
	}
}

## The system heap, what the root context allocates from.
## Delegate to it from a custom allocator.
pub system_allocator :: fn() Allocator {
	unsafe rt.oi_system_allocator()
}

## A fresh bump arena.
## Allocating is a pointer bump, freeing is a no-op, and `free_all` rewinds.
pub arena :: fn() Allocator {
	unsafe rt.oi_arena()
}

## Log severity, ordered.
pub Level :: enum { debug = -1, info = 0, warn = 1, error = 2 }

## Where `log.info(..)` and friends end up.
pub Logger :: struct {
	pub proc: ?fn(data: ptr, level: Level, msg: string)
	pub level: Level = .info
	pub data: ptr
}

## The root context's logger.
pub default_log :: fn(data: ptr, level: Level, msg: string) {
	eprint("[{level}] {msg}")
}

pub Context :: struct {
	pub alloc: Allocator
	pub temp: Allocator
	pub log: Logger
	pub panic: fn(msg: string, at: Src)
	pub rand: ptr
	pub thread: int
}
