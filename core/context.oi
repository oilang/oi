module core

## The implicit `ctx` carried by most functions.

use rt

## `Alloc.proc` modes.
pub AllocMode :: enum {
	alloc,
	free,
	# resize,
	free_all = 3,
}

## A C-callable allocator record.
pub Alloc :: struct {
	pub proc: @c fn(data: ptr, mode: AllocMode, size: int, align: int, old: ptr, old_size: int) ptr
	pub data: ptr
}

Alloc :< {
	## Hand back everything allocated so far, for allocators that free everything at once.
	pub free_all :: fn(self) {
		_ := self.proc(self.data, .free_all, 0, 0, ptr(0), 0)
	}
}

## Claimers coerce to `Alloc`.
pub Allocator :: trait {
	alloc: fn(mut self, size: int, align: int) ptr
	free :: fn(mut self, old: ptr, old_size: int) { () }
	free_all :: fn(mut self) { () }
}

# `Alloc.proc` for a claimer `T` behind `data`.
pub alloc_shim[T: Allocator] :: fn(data: ptr, mode: AllocMode, size: int, align: int, old: ptr, old_size: int) ptr {
	match mode {
		.alloc => unsafe T.(data).alloc(size, align),
		.free => {
			unsafe T.(data).free(old, old_size)
			ptr(0)
		},
		.free_all => {
			unsafe T.(data).free_all()
			ptr(0)
		},
	}
}

## The system heap, what the root context allocates from.
## Delegate to it from custom allocators.
pub system_allocator :: fn() Alloc {
	unsafe rt.oi_system_allocator()
}

## A fresh bump arena.
## Allocating is a pointer bump, freeing is a no-op, and `free_all` rewinds.
pub arena :: fn() Alloc {
	unsafe rt.oi_arena()
}

## Log severity, ordered.
pub Level :: enum {
	debug = -1,
	info = 0,
	warn = 1,
	error = 2,
}

## Where `log.info(..)` and friends end up.
pub Logger :: struct {
	pub proc: ?fn(data: ptr, level: Level, msg: string)
	pub level: Level = .info
	pub data: ptr
}

## The root context's logger.
pub default_log :: fn(data: ptr, level: Level, msg: string) {
	eprint("[{level}] {msg}")
}

## A C-callable generator.
pub Rng :: struct {
	pub proc: @c fn(data: ptr) u64
	pub data: ptr
}

pub Context :: struct {
	pub alloc: Alloc
	pub temp: Alloc
	pub log: Logger
	pub panic: fn(msg: string, at: Src)
	pub rand: Rng
	pub thread: int
}
