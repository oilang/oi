module base64

letters :: "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789"

## Base64 text of a string's bytes, padded with `=`.
pub encode :: fn(s: string, url := false) string {
	alphabet :: letters + if url do "-_" else do "+/"
	out: []u8 = []
	acc := 0
	bits := 0
	loop i in 0..s.len() {
		acc = ((acc << 8) | int.(s[i])) & 0xffffff
		bits += 8
		loop bits >= 6 {
			bits -= 6
			out << alphabet[(acc >> bits) & 63]
		}
	}

	if bits > 0 {
		out << alphabet[(acc << (6 - bits)) & 63]
	}

	loop out.len() % 4 != 0 {
		out << 61
	}

	string.(out)
}

## Value of a base64 digit in either alphabet, or -1.
digit :: fn(c: u8, url: bool) int {
	n :: int.(c)
	match n {
		65..=90 => n - 65,
		97..=122 => n - 71,
		48..=57 => n + 4,
		43 if !url => 62,
		47 if !url => 63,
		45 if url => 62,
		95 if url => 63,
		_ => -1,
	}
}

## The bytes of base64 text, padding optional.
pub decode :: fn(s: string, url := false) !string {
	out: []u8 = []
	acc := 0
	bits := 0
	loop i in 0..s.len() {
		if s[i] == 61 do break

		d :: digit(s[i], url)
		if d < 0 do return error("base64: bad char at {i}")

		acc = ((acc << 6) | d) & 0xffffff
		bits += 6
		if bits >= 8 {
			bits -= 8
			out << u8.((acc >> bits) & 255)
		}
	}

	string.(out)
}
