module core

## Binds a def to the compiler role named by `key`.
pub lang :: struct { key: string }

@lang.{"params"} pub params :: ()
@lang.{"required"} pub required :: ()

@lang.{"test"} pub test :: struct {
	name: string = ""
	skip: bool = false
}

## Expands to a `@test` fn right now.
pub test! :: fn(name: Ast, body: Ast) Ast {
	id := gensym("test")
	`@test.{%name} %id :: fn() { %{..body.items} }`
}

@lang.{"link"} pub link :: struct { lib: string, name: string }
@lang.{"export"} pub export :: struct { name: string }

## Marks a struct as also describing a C struct.
@lang.{"c"} pub c :: ()

## Marks a trait as satisfied by shape alone.
@lang.{"implicit"} pub implicit :: ()

## Marks a fn as free of I/O and other impure calls.
@lang.{"pure"} pub pure :: ()

## Ensures a type is always explicitly initialized.
@lang.{"nozero"} pub nozero :: ()

## Bans struct literals for this type outside its own module.
@lang.{"noinit"} pub noinit :: ()

## Lets other modules add defaulted fields to a struct with `:<`.
@lang.{"open"} pub open :: ()

## A fn that can run on another thread.
@lang.{"isolated"} pub isolated :: ()
