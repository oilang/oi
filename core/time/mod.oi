module time

use math.{ round }

malloc : fn(n: usize) ptr : foreign
free : fn(p: ptr) : foreign
clock_gettime : fn(clock: i32, spec: ptr) i32 : foreign
nanosleep : fn(req: ptr, rem: ptr) i32 : foreign
localtime : fn(t: ptr) ptr : foreign
gmtime : fn(t: ptr) ptr : foreign
strftime : fn(buf: ptr, max: usize, fmt: cstr, tm: ptr) usize : foreign

@c
Spec :: struct {
	sec: int
	nsec: int
}

clock :: fn(id: i32) int {
	p := unsafe malloc(Spec.size)
	_ := unsafe clock_gettime(id, p)
	s :: unsafe p.read[Spec]()
	unsafe free(p)
	s.sec * 1000000000 + s.nsec
}

## A span of time, in nanoseconds.
pub Duration :: struct {
	pub ns: int
}

int :< {
	pub ns :: fn(self) Duration { .{ self } }
	pub us :: fn(self) Duration { .{ self * 1000 } }
	pub ms :: fn(self) Duration { .{ self * 1000000 } }
	pub sec :: fn(self) Duration { .{ self * 1000000000 } }
	pub min :: fn(self) Duration { .{ self * 60000000000 } }
	pub hr :: fn(self) Duration { .{ self * 3600000000000 } }
}

float :< {
	pub ns :: fn(self) Duration { .{ int.(round(self)) } }
	pub us :: fn(self) Duration { .{ int.(round(self * 1e3)) } }
	pub ms :: fn(self) Duration { .{ int.(round(self * 1e6)) } }
	pub sec :: fn(self) Duration { .{ int.(round(self * 1e9)) } }
	pub min :: fn(self) Duration { .{ int.(round(self * 6e10)) } }
	pub hr :: fn(self) Duration { .{ int.(round(self * 3.6e12)) } }
}

Duration :< {
	pub us :: fn(self) float { float.(self.ns) / 1e3 }
	pub ms :: fn(self) float { float.(self.ns) / 1e6 }
	pub sec :: fn(self) float { float.(self.ns) / 1e9 }
	pub min :: fn(self) float { float.(self.ns) / 6e10 }
	pub hr :: fn(self) float { float.(self.ns) / 3.6e12 }

	pub str :: fn(self) string {
		match true {
			self.ns >= 1000000000 => "{self.sec()}s",
			self.ns >= 1000000 => "{self.ms()}ms",
			self.ns >= 1000 => "{self.us()}us",
			else => "{self.ns}ns",
		}
	}
}

Duration : Add < {
	add :: fn(self, o: Self) Self { .{ self.ns + o.ns } }
}
Duration : Sub < {
	sub :: fn(self, o: Self) Self { .{ self.ns - o.ns } }
}
Duration : Div < {
	Out :: float
	div :: fn(self, o: Self) Out { float.(self.ns) / float.(o.ns) }
}
Duration : Mul[int] < {
	mul :: fn(self, k: int) Self { .{ self.ns * k } }
}
Duration : Mul[float] < {
	mul :: fn(self, k: float) Self { .{ int.(round(float.(self.ns) * k)) } }
}
Duration : Ord < {
	lt :: fn(self, o: Self) bool { self.ns < o.ns }
}

## Monotonic time.
pub Instant :: struct {
	ns: int
}

Instant :< {
	pub now :: fn() Self { .{ clock(1) } }
	pub elapsed :: fn(self) Duration { .{ clock(1) - self.ns } }

	## Get elapsed Duration since the last lap, then restart.
	pub lap :: fn(mut self) Duration {
		t :: clock(1)
		d :: Duration.{ t - self.ns }
		self.ns = t
		d
	}
}

Instant : Sub < {
	Out :: Duration
	sub :: fn(self, o: Self) Out { .{ self.ns - o.ns } }
}
Instant : Sub[Duration] < {
	sub :: fn(self, d: Duration) Self { .{ self.ns - d.ns } }
}
Instant : Add[Duration] < {
	add :: fn(self, d: Duration) Self { .{ self.ns + d.ns } }
}
Instant : Ord < {
	lt :: fn(self, o: Self) bool { self.ns < o.ns }
}

## Clock time, in nanoseconds since the Unix epoch.
pub Time :: struct {
	pub ns: int
}

Time :< {
	pub now :: fn() Self { .{ clock(0) } }

	## RFC 3339 in UTC, with milliseconds.
	pub str :: fn(self) string {
		ms :: self.ns / 1000000 % 1000
		pad :: if ms < 10 do "00" else if ms < 100 do "0" else do ""
		head :: self.zoned(true, "%Y-%m-%dT%H:%M:%S")
		"{head}.{pad}{ms}Z"
	}

	## Render in local time with `strftime` directives.
	pub format :: fn(self, fmt: string) string { self.zoned(false, fmt) }

	zoned :: fn(self, utc: bool, fmt: string) string {
		buf := unsafe malloc(128)
		unsafe buf.write(self.ns / 1000000000)
		n :: unsafe strftime(buf, 128, fmt.cstr(), if utc do gmtime(buf) else do localtime(buf))
		out :: unsafe buf.string(int.(n))
		unsafe free(buf)
		out
	}
}

## Measure the time `f` takes to run.
pub measure :: fn(f: fn()) Duration {
	t :: Instant.now()
	f()
	t.elapsed()
}

pub sleep :: fn(d: Duration) {
	p := unsafe malloc(Spec.size)
	unsafe p.write(Spec.{ d.ns / 1000000000, d.ns % 1000000000 })
	_ := unsafe nanosleep(p, ptr(0))
	unsafe free(p)
}
