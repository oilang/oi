module os

use rt
use libc

## The command-line arguments, program path first.
pub args :: fn() out: []string {
	n :: unsafe rt.oi_argc()
	loop i in 0..n {
		out << unsafe rt.oi_argv(i).str()
	}
	out
}

## Read an env var.
pub env :: fn(name: string) ?string {
	p :: unsafe libc.getenv(name.cstr())
	if p.is_null() { return }
	unsafe cstr.(p).str()
}

## Set an env var for this process.
pub set_env :: fn(name: string, value: string) {
	_ := unsafe libc.setenv(name.cstr(), value.cstr(), 1)
}

## Get the working directory.
pub cwd :: fn() string {
	p :: unsafe libc.getcwd(ptr.(0), 0)
	s :: unsafe cstr.(p).str()
	unsafe libc.free(p)
	s
}

## Get the process id.
pub pid :: fn() int {
	int.(unsafe libc.getpid())
}

## Run a shell command, returning its exit status.
pub sh :: fn(cmd: string) u8 {
	u8.(unsafe libc.system(cmd.cstr()) >> 8)
}

## End the process with `code`.
pub exit :: fn(code := 0) {
	unsafe libc.exit(i32.(code))
}
