module sync

use time.{ Duration }

## Threads and channels.

oi_thread_spawn : fn(move job: any) ptr : foreign
oi_thread_join : fn(handle: ptr) any : foreign
oi_thread_detach : fn(handle: ptr) : foreign
oi_chan_new : fn() ptr : foreign
oi_chan_retain : fn(chan: ptr) : foreign
oi_chan_release : fn(chan: ptr) : foreign
oi_chan_send : fn(chan: ptr, cap: int, move packet: ^Packet, ns: int) int : foreign
oi_chan_recv : fn(chan: ptr, ns: int) ?^Packet : foreign
oi_chan_close : fn(chan: ptr) : foreign
oi_chan_closed : fn(chan: ptr) int : foreign

Packet :: struct {
	value: any
}

## Blocks until it yields a `T`.
pub Waitable[T] :: trait {
	wait: fn(move self) T
}

## A running thread. Dropping it detaches.
pub Thread[T] :: struct {
	handle: ptr
}

Thread[T] : Drop < {
	drop :: fn(mut self) {
		unsafe oi_thread_detach(self.handle)
	}
}

Thread[T] : Waitable[T] < {
	wait :: fn(move self) T {
		T.(unsafe oi_thread_join(self.handle)) or panic!("sync: bad thread result")
	}
}

## Waits on each in turn.
[T, W: Waitable[T]] []W : Waitable[[]T] < {
	wait :: fn(move self) []T {
		loop w in move self do w.wait()
	}
}

## Run `f` on a new thread.
pub start[T] :: fn(move f: @isolated fn() T) Thread[T] {
	job: any = fn [move f] () any { f() }
	.{ handle = unsafe oi_thread_spawn(move job) }
}

## Run an expression on a new thread.
pub spawn! :: fn(expr: Ast) Ast {
	`{
		f: @isolated fn() type(%expr) = fn { %expr }
		sync.start(move f)
	}`
}

## A channel between threads.
## Unbounded when `cap` is 0.
pub Chan[T: Isolated] :: struct {
	pub cap: int
	handle: ptr = unsafe oi_chan_new()
}

Chan[T] : Drop, Copy < {
	drop :: fn(mut self) {
		unsafe oi_chan_release(self.handle)
	}
	copy :: fn(mut self) {
		unsafe oi_chan_retain(self.handle)
	}
}

Chan[T] :< {
	## Fail future sends. Receivers drain, then get none.
	pub close :: fn(self) {
		unsafe oi_chan_close(self.handle)
	}

	pub closed :: fn(self) bool { unsafe oi_chan_closed(self.handle) != 0 }
	pub try_send :: fn(self, move value: T) !() { self.send_within(move value, 0.ns()) }
	pub try_recv :: fn(self) ?T { self.recv_within(0.ns()) }

	## Send, waiting at most `d`, forever when negative.
	pub send_within :: fn(self, move value: T, d: Duration) !() {
		if unsafe oi_chan_send(self.handle, self.cap, move &Packet.{ value = __unshare(value) }, d.ns) == 0 {
			return error("closed")
		}
	}

	pub recv_within :: fn(self, d: Duration) ?T {
		packet := unsafe oi_chan_recv(self.handle, d.ns) or return none
		T.(packet.value)
	}
}

Chan[T] : Send[T] < {
	send :: fn(self, move value: T) !() {
		self.send_within(move value, (-1).ns())
	}
}

Chan[T] : Recv[T] < {
	recv :: fn(self) ?T {
		self.recv_within((-1).ns())
	}
}

Chan[T] : Iterator[T] < {
	next :: fn(mut self) ?T {
		self.recv()
	}
}
