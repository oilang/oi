module sync

use time.{ Duration, Instant }

## Threads and channels.

oi_thread_spawn : fn(move job: any) : foreign
oi_signal_new : fn() ptr : foreign
oi_signal_release : fn(s: ptr) : foreign
oi_signal_within : fn(s: ptr, ns: int) : foreign
oi_signal_sleep : fn(s: ptr) : foreign
oi_chan_watch : fn(chan: ptr, s: ptr) : foreign
oi_chan_new : fn() ptr : foreign
oi_chan_retain : fn(chan: ptr) : foreign
oi_chan_release : fn(chan: ptr) : foreign
oi_chan_send : fn(chan: ptr, cap: int, move packet: ^Packet, ns: int) int : foreign
oi_chan_recv : fn(chan: ptr, ns: int) ?^Packet : foreign
oi_chan_close : fn(chan: ptr) : foreign
oi_chan_closed : fn(chan: ptr) int : foreign

Packet :: struct {
	value: any
}

## Blocks until it yields a `T`.
pub Waitable[T] :: trait {
	wait: fn(move self) T
}

## Yields without blocking, none until ready.
pub Pollable[T] :: trait {
	poll: fn(mut self) ?T
	watch: fn(self, s: Signal)
}

## Wakes a sleeper once a watched pollable may be ready.
pub Signal :: struct {
	handle: ptr = unsafe oi_signal_new()
}

Signal : Drop < {
	drop :: fn(mut self) {
		unsafe oi_signal_release(self.handle)
	}
}

Signal :< {
	pub sleep :: fn(self) {
		unsafe oi_signal_sleep(self.handle)
	}
}

## A running thread, with the channel its result arrives on.
pub Thread[T] :: struct {
	done: Chan[T] = .{}
}

Thread[T] : Waitable[T] < {
	wait :: fn(move self) T {
		self.done.recv() or panic!("sync: thread died")
	}
}

Thread[T] : Pollable[T] < {
	poll :: fn(mut self) ?T {
		self.done.try_recv()
	}
	watch :: fn(self, s: Signal) {
		self.done.watch(s)
	}
}

## Waits on each in turn.
[T, W: Waitable[T]] []W : Waitable[[]T] < {
	wait :: fn(move self) []T {
		loop w in move self do w.wait()
	}
}

## Run `f` on a new thread.
pub start[T] :: fn(move f: @isolated fn() T) Thread[T] {
	done := Chan[T].{}
	d := done
	job: any = fn [move f, move d] () () {
		d <- f() or ()
		d.close()
	}
	unsafe oi_thread_spawn(move job)
	.{ done }
}

## Run an expression on a new thread.
pub spawn! :: fn(expr: Ast) Ast {
	`{
		f: @isolated fn() type(%expr) = fn { %expr }
		sync.start(move f)
	}`
}

## A channel between threads.
## Unbounded when `cap` is 0.
pub Chan[T: Isolated] :: struct {
	pub cap: int
	handle: ptr = unsafe oi_chan_new()
}

Chan[T] : Drop, Copy < {
	drop :: fn(mut self) {
		unsafe oi_chan_release(self.handle)
	}
	copy :: fn(mut self) {
		unsafe oi_chan_retain(self.handle)
	}
}

Chan[T] :< {
	## Fail future sends. Receivers drain, then get none.
	pub close :: fn(self) {
		unsafe oi_chan_close(self.handle)
	}

	pub closed :: fn(self) bool { unsafe oi_chan_closed(self.handle) != 0 }
	pub try_send :: fn(self, move value: T) !() { self.send_within(move value, 0.ns()) }
	pub try_recv :: fn(self) ?T { self.recv_within(0.ns()) }

	## Send, waiting at most `d`, forever when negative.
	pub send_within :: fn(self, move value: T, d: Duration) !() {
		if unsafe oi_chan_send(self.handle, self.cap, &Packet.{ value = __unshare(value) }, d.ns) == 0 {
			return error("closed")
		}
	}

	pub recv_within :: fn(self, d: Duration) ?T {
		packet := unsafe oi_chan_recv(self.handle, d.ns) or return none
		T.(packet.value)
	}
}

Chan[T] : Send[T] < {
	send :: fn(self, move value: T) !() {
		self.send_within(move value, (-1).ns())
	}
}

Chan[T] : Recv[T] < {
	recv :: fn(self) ?T {
		self.recv_within((-1).ns())
	}
}

## Fires none once closed and drained.
Chan[T] : Pollable[?T] < {
	poll :: fn(mut self) ??T {
		shut := self.closed()
		v := self.try_recv()
		if v == none && !shut do return none
		v
	}
	watch :: fn(self, s: Signal) {
		unsafe oi_chan_watch(self.handle, s.handle)
	}
}

Chan[T] : Iterator[T] < {
	next :: fn(mut self) ?T {
		self.recv()
	}
}

## A wait group.
## Joins its threads in order of adding them.
pub Group[T] :: struct {
	threads: Chan[Thread[T]] = .{}
}

Group[T] :< {
	pub add :: fn(self, move t: Thread[T]) {
		self.threads <- move t or panic!("sync: add after wait")
	}
}

Group[T] : Waitable[[]T] < {
	wait :: fn(move self) out: []T {
		loop {
			t := self.threads.try_recv() or break
			out << t.wait()
		}
		self.threads.close()
		out
	}
}

## Requeues members while polling, so a concurrent `add` can land between them.
Group[T] : Pollable[[]T] < {
	poll :: fn(mut self) ?[]T {
		ts := loop { self.threads.try_recv() or break }
		ready := true

		loop t in ts { ready = ready && t.done.closed() }
		if ready do return ts.wait()

		loop t in move ts do self.add(move t)
		none
	}

	watch :: fn(self, s: Signal) {
		ts := loop { self.threads.try_recv() or break }
		loop t in move ts {
			t.watch(s)
			self.add(move t)
		}
	}
}

## Ready once `d` has passed, a timer for `select!`.
pub after :: fn(d: Duration) After {
	.{ Instant.now() + d }
}

pub After :: struct {
	at: Instant
}

After : Pollable[()] < {
	poll :: fn(mut self) ?() {
		if Instant.now() < self.at { none } else { () }
	}
	watch :: fn(self, s: Signal) {
		unsafe oi_signal_within(s.handle, (self.at - Instant.now()).ns)
	}
}

## Waits on the first ready arm, `else` when none is ready.
pub select! :: fn(arms: Ast) Ast {
	s := gensym("s")
	pre: []Ast
	tries: []Ast
	wait: []Ast
	idle: []Ast

	loop a in arms.items {
		[ lhs body ] := a.items
		if lhs == "else" {
			idle << `break :select %body`
			continue
		}

		w := gensym("w")
		bind := lhs.kind == "bind"
		x := if bind { lhs.name } else { gensym("x") }
		e := if bind { lhs.items[0] } else { lhs }

		ready := `%w.poll()`
		pre << match e {
			`%c <- %v` => {
				ready = `%w.try_send(move %v)`
				`%w := %c`
			}
			`<-%c` => `%w := %c`
			else => `%w := %e`
		}
		tries << `%{tries.len} => { %x := %ready or continue; break :select %body }`
		wait << `%w.watch(%s)`
	}

	wait << `%s.sleep()`
	n := tries.len

	`:select {
		%{..pre}
		%s := sync.Signal.{}
		k := int.(ctx.rand.proc(ctx.rand.data) % u64.(%n))
		loop {
			loop j in 0..%n {
				match (k + j) % %n { %{..tries} else => () }
			}
			%{..if idle.len > 0 { idle } else { wait }}
		}
	}`
}
