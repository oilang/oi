module core

float :< {
	## Smallest step between distinct `float` values near 1.0.
	epsilon :: 2.0 ** -52.0

	## Whether this is NaN.
	is_nan :: fn(self) bool {
		self != self
	}

	## Whether this is positive or negative infinity.
	is_inf :: fn(self) bool {
		self == inf || self == -inf
	}
}

f32 :< {
	epsilon :: 2.0 ** -23.0
}

## Floating point, of any width.
pub Float :: trait {}
float :< Float
f32 :< Float
f16 :< Float
