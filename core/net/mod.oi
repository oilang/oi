module net

use math
use libc

## sockaddr_in
@c Addr :: struct {
	family: u16
	port: u16
	ip: u32
	zero: u64
}

## Connect to the unix socket at the given path.
pub connect_unix :: fn(path: string) !Conn {
	if path.len() > 107 do return error("path too long {path}")

	fd :: unsafe libc.socket(1, 1, 0)
	defer or discard unsafe libc.close(fd)

	# sockaddr_un: u16 family then a zeroed 108 byte path
	buf :: unsafe libc.calloc(110, 1)
	defer unsafe libc.free(buf)

	unsafe buf.write(u16.(1))
	discard unsafe libc.memcpy(buf.offset(2), path.ptr, usize.(path.len()))
	if unsafe libc.connect(fd, buf, 110) != 0 do return error("cannot connect to {path}")

	Conn.{ fd }
}

pub Conn :: struct { fd: i32 }
pub Listener :: struct { fd: i32 }

## Connect to a dotted IPv4 `host` (or "localhost") on `port`.
pub connect :: fn(host: string, port: int) !Conn {
	Conn.{ sock(host, port, false)? }
}

## Listen for TCP connections on `port`, on every interface.
## `0` picks a free port.
pub listen :: fn(port: int) !Listener {
	Listener.{ sock("0.0.0.0", port, true)? }
}

## A TCP socket connected to / serving on `host:port`.
sock :: fn(host: string, port: int, serve: bool) !i32 {
	h :: if host == "localhost" { "127.0.0.1" } else { host }
	ip :: unsafe libc.inet_addr(h.cstr())
	if ip == 4294967295 { return error("bad address {host}") }
	fd :: unsafe libc.socket(2, 1, 0)
	defer or discard unsafe libc.close(fd)
	buf := unsafe libc.malloc(Addr.size)
	defer unsafe libc.free(buf)
	unsafe buf.write(i32.(1))

	if serve {
		# SO_REUSEADDR
		_ := unsafe libc.setsockopt(fd, 1, 2, buf, 4)
	}
	unsafe buf.write(Addr.{ 2, u16.((port >> 8) | ((port & 255) << 8)), ip, 0 })
	ok :: if serve {
		unsafe libc.bind(fd, buf, 16) == 0 && unsafe libc.listen(fd, 128) == 0
	} else {
		unsafe libc.connect(fd, buf, 16) == 0
	}
	if !ok { return error(if serve { "cannot listen on port {port}" } else { "cannot connect to {host}:{port}" }) }
	fd
}

Listener :< {
	## The bound port.
	pub port :: fn(self) int {
		# the sockaddr_in then its u32 length
		buf :: unsafe libc.malloc(20)
		defer unsafe libc.free(buf)

		unsafe buf.offset(16).write(u32.(16))
		discard unsafe libc.getsockname(self.fd, buf, buf.offset(16))

		swapped :: int.(unsafe buf.read[Addr]().port)
		(swapped >> 8) | ((swapped & 255) << 8)
	}

	## Block until a client connects.
	pub accept :: fn(self) !Conn {
		fd :: unsafe libc.accept(self.fd, ptr.(0), ptr.(0))
		if fd < 0 { return error("accept failed") }
		Conn.{ fd }
	}

	pub close :: fn(self) {
		discard unsafe libc.close(self.fd)
	}
}

Conn :< {
	## Send a string.
	pub write :: fn(self; s: string) ! {
		sent := 0
		discard loop sent < s.len() {
			# MSG_NOSIGNAL
			n :: unsafe libc.send(self.fd, s.ptr.offset(sent), usize.(s.len() - sent), 16384)
			if n < 0 { return error("write failed") }
			sent += int.(n)
		}
	}

	## Receive up to `max` bytes, empty once the peer has closed.
	pub read :: fn(self; max := 4096) !string {
		buf := unsafe libc.malloc(usize.(max))
		n :: unsafe libc.recv(self.fd, buf, usize.(max), 0)
		out :: unsafe buf.string(math.max(0, int.(n)))
		unsafe libc.free(buf)
		if n < 0 { return error("read failed") }
		out
	}

	pub close :: fn(self) {
		discard unsafe libc.close(self.fd)
	}
}
