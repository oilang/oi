module math

## Absolute value.
pub abs[T] :: fn(x: T) T {
	if x < 0 { -x } else { x }
}

## Minimum of two values.
pub min[T] :: fn(a: T, b: T) T {
	if a < b { a } else { b }
}

## Maximum of two values.
pub max[T] :: fn(a: T, b: T) T {
	if a > b { a } else { b }
}

## Clamp a value between two bounds.
pub clamp[T] :: fn(x: T, low: T, high: T) T {
	match true {
		x < low => low,
		x > high => high,
		else => x
	}
}

## Round down to the nearest integer.
## ref: https://github.com/rust-lang/libm/blob/rewritten-libm-v0.2.8/src/math/floor.rs
pub floor :: fn(x: float) float {
	whole :: 1.0 / float.epsilon
	if x != x || abs(x) >= whole { return x }
	magic :: 1.5 * whole
	# HACK: rounding sorcery
	t :: x + magic - magic
	match true {
		t > x => t - 1.0,
		x - t >= 1.0 => t + 1.0,
		else => t
	}
}

## Round up to the nearest integer.
pub ceil :: fn(x: float) float {
	-floor(-x)
}

## -1, 0, or 1 depending on the sign of `x`.
pub sign :: fn(x: float) int {
	match true {
		x < 0.0 => -1,
		x > 0.0 => 1,
		else => 0
	}
}

# ref: https://github.com/golang/go/blob/master/src/math/exp.go
ln2_hi :: 0.693147180369123816490
ln2_lo :: 1.90821492927058770002e-10

## Euler's number `e` raised to the power `x`.
pub exp :: fn(x: float) float {
	if x != x { return x }
	# past 2^1024 overflows, and under 2^-1074 rounds to zero
	if x > 1024.0 * ln2 { return inf }
	if x < -1075.0 * ln2 { return 0.0 }

	k :: floor(x / ln2 + 0.5)
	r :: (x - k * ln2_hi) - k * ln2_lo

	# sum the series until its terms are too small to change the result
	sum := 1.0
	term := 1.0
	last := 0.0
	i := 1
	loop sum != last {
		last = sum
		term *= r / float.(i)
		sum += term
		i += 1
	}

	# scale into the sum directly so 2^k alone can't overflow first
	step :: if k < 0.0 { 0.5 } else { 2.0 }
	n := abs(k)
	loop n > 0.0 {
		sum *= step
		n -= 1.0
	}
	sum
}

## Natural logarithm.
## ref: https://dlmf.nist.gov/4.6
pub log :: fn(x: float) float {
	if x != x || x == inf { return x }
	if x < 0.0 { return nan }
	if x == 0.0 { return -inf }

	m := x
	k := 0
	loop m >= 2.0 {
		m /= 2.0
		k += 1
	}
	loop m < 1.0 {
		m *= 2.0
		k -= 1
	}
	if m > sqrt2 {
		m /= 2.0
		k += 1
	}

	# ln m = 2 atanh((m - 1) / (m + 1))
	t :: (m - 1.0) / (m + 1.0)
	t2 :: t * t
	sum := t
	term := t
	last := 0.0
	i := 1
	loop sum != last {
		last = sum
		term *= t2
		sum += term / float.(2 * i + 1)
		i += 1
	}

	2.0 * sum + float.(k) * ln2
}

## Base 2 logarithm.
pub log2 :: fn(x: float) float {
	log(x) / ln2
}

## Base 10 logarithm.
pub log10 :: fn(x: float) float {
	log(x) / ln10
}

## Sine of `x`, in radians.
## ref: https://dlmf.nist.gov/4.19
pub sin :: fn(x: float) float {
	if x != x || abs(x) == inf { return nan }

	y := x - tau * floor(x / tau)
	if y > pi { y -= tau }
	if y > pi / 2.0 { y = pi - y }
	if y < -(pi / 2.0) { y = -pi - y }

	term := y
	sum := y
	last := 0.0
	i := 1
	loop sum != last {
		last = sum
		term = -term * y * y / float.(2 * i * (2 * i + 1))
		sum += term
		i += 1
	}
	sum
}

## Cosine of `x`, in radians.
pub cos :: fn(x: float) float {
	sin(pi / 2.0 - x)
}

## Tangent of `x`, in radians.
pub tan :: fn(x: float) float {
	sin(x) / cos(x)
}

## Square root.
pub sqrt[T] :: fn(n: T) float {
	x :: float.(n)
	if x != x || x < 0.0 { return nan }
	if x == 0.0 || x == inf { return x }
	r := exp(log(x) / 2.0)
	loop _ in 0..3 {
		r = (r + x / r) / 2.0
	}
	r
}

## Round.
pub round :: fn(x: float) float {
	if x < 0.0 { -floor(0.5 - x) } else { floor(x + 0.5) }
}

## Truncate.
pub trunc :: fn(x: float) int {
	int.(x)
}

## Linear interpolation.
pub lerp :: fn(from: float, to: float, by: float) float {
	from + (to - from) * by
}

## Length of the hypotenuse.
pub hypot :: fn(x: float, y: float) float {
	sqrt(x ** 2 + y ** 2)
}

# ref: https://github.com/golang/go/blob/master/src/math/atan.go, from Cephes atan.c
atan_p :: [-8.750608600031904122785e-01, -1.615753718733365076637e+01, -7.500855792314704667340e+01, -1.228866684490136173410e+02, -6.485021904942025371773e+01]
atan_q :: [2.485846490142306297962e+01, 1.650270098316988542046e+02, 4.328810604912902668951e+02, 4.853903996359136964868e+02, 1.945506571482613964425e+02]
# what pi / 2.0 loses to rounding
morebits :: 6.123233995736765886130e-17
tan3pio8 :: 2.41421356237309504880

# x + x^3 P(x^2) / Q(x^2), valid on [0, 0.66]
xatan :: fn(x: float) float {
	z :: x * x
	p :: (((atan_p[0] * z + atan_p[1]) * z + atan_p[2]) * z + atan_p[3]) * z + atan_p[4]
	q :: ((((z + atan_q[0]) * z + atan_q[1]) * z + atan_q[2]) * z + atan_q[3]) * z + atan_q[4]
	x * z * p / q + x
}

## Arc tangent, in radians.
pub atan :: fn(x: float) float {
	if x == 0.0 do return x
	if x < 0.0 do return -atan(-x)
	if x <= 0.66 do return xatan(x)
	if x > tan3pio8 do return pi / 2.0 - xatan(1.0 / x) + morebits
	pi / 4.0 + xatan((x - 1.0) / (x + 1.0)) + 0.5 * morebits
}

## Angle of the point `(x, y)` from the positive x axis, in radians.
pub atan2 :: fn(y: float, x: float) float {
	match true {
		x > 0.0 => atan(y / x),
		x < 0.0 && y >= 0.0 => atan(y / x) + pi,
		x < 0.0 => atan(y / x) - pi,
		y > 0.0 => pi / 2.0,
		y < 0.0 => -(pi / 2.0),
		else => 0.0,
	}
}

## Arc sine, in radians.
pub asin :: fn(x: float) float {
	if abs(x) > 1.0 { return nan }
	if abs(x) == 1.0 { return x * pi / 2.0 }
	atan(x / sqrt(1.0 - x * x))
}

## Arc cosine, in radians.
pub acos :: fn(x: float) float {
	pi / 2.0 - asin(x)
}
