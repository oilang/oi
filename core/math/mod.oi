module math

## Absolute value.
pub abs[T] :: fn(x: T) T {
	if x < 0 { -x } else { x }
}

## Minimum of two values.
pub min[T] :: fn(a: T, b: T) T {
	if a < b { a } else { b }
}

## Maximum of two values.
pub max[T] :: fn(a: T, b: T) T {
	if a > b { a } else { b }
}

## Clamp a value between two bounds.
pub clamp[T] :: fn(x: T, low: T, high: T) T {
	match true {
		x < low => low,
		x > high => high,
		else => x
	}
}

## Round down to the nearest integer.
## ref: https://github.com/rust-lang/libm/blob/rewritten-libm-v0.2.8/src/math/floor.rs
pub floor :: fn(x: float) float {
	if x != x || abs(x) >= 4503599627370496.0 { return x }
	magic :: 6755399441055744.0
	t :: x + magic - magic
	match true {
		t > x => t - 1.0,
		x - t >= 1.0 => t + 1.0,
		else => t
	}
}

## Round up to the nearest integer.
pub ceil :: fn(x: float) float {
	-floor(-x)
}

## -1, 0, or 1 depending on the sign of `x`.
pub sign :: fn(x: float) int {
	match true {
		x < 0.0 => -1,
		x > 0.0 => 1,
		else => 0
	}
}

# ref: https://github.com/golang/go/blob/master/src/math/exp.go
ln2_hi :: 0.693147180369123816490
ln2_lo :: 1.90821492927058770002e-10

## Euler's number `e` raised to the power `x`.
pub exp :: fn(x: float) float {
	if x != x { return x }
	if x > 709.782712893384 { return inf }
	if x < -745.133219101941 { return 0.0 }

	k :: floor(x / ln2 + 0.5)
	r :: (x - k * ln2_hi) - k * ln2_lo

	sum := 1.0
	term := 1.0
	loop i in 1..15 {
		term *= r / float.(i)
		sum += term
	}

	# scale into the sum directly so 2^k alone can't overflow first
	step :: if k < 0.0 { 0.5 } else { 2.0 }
	n := abs(k)
	loop n > 0.0 {
		sum *= step
		n -= 1.0
	}
	sum
}

## Natural logarithm.
## ref: https://dlmf.nist.gov/4.6
pub log :: fn(x: float) float {
	if x != x || x == inf { return x }
	if x < 0.0 { return nan }
	if x == 0.0 { return -inf }

	m := x
	k := 0
	loop m >= 2.0 {
		m /= 2.0
		k += 1
	}
	loop m < 1.0 {
		m *= 2.0
		k -= 1
	}
	if m > sqrt2 {
		m /= 2.0
		k += 1
	}

	# ln m = 2 atanh((m - 1) / (m + 1))
	t :: (m - 1.0) / (m + 1.0)
	t2 :: t * t
	sum := t
	term := t
	loop i in 1..10 {
		term *= t2
		sum += term / float.(2 * i + 1)
	}

	2.0 * sum + float.(k) * ln2
}

## Base 2 logarithm.
pub log2 :: fn(x: float) float {
	log(x) / ln2
}

## Base 10 logarithm.
pub log10 :: fn(x: float) float {
	log(x) / ln10
}

## Sine of `x`, in radians.
## ref: https://dlmf.nist.gov/4.19
pub sin :: fn(x: float) float {
	if x != x || abs(x) == inf { return nan }

	y := x - tau * floor(x / tau)
	if y > pi { y -= tau }
	if y > pi / 2.0 { y = pi - y }
	if y < -(pi / 2.0) { y = -pi - y }

	term := y
	sum := y
	loop i in 1..11 {
		term = -term * y * y / float.(2 * i * (2 * i + 1))
		sum += term
	}
	sum
}

## Cosine of `x`, in radians.
pub cos :: fn(x: float) float {
	sin(pi / 2.0 - x)
}

## Tangent of `x`, in radians.
pub tan :: fn(x: float) float {
	sin(x) / cos(x)
}

## Square root.
pub sqrt :: fn(x: float) float {
	if x != x || x < 0.0 { return nan }
	if x == 0.0 || x == inf { return x }
	r := exp(log(x) / 2.0)
	loop _ in 0..3 {
		r = (r + x / r) / 2.0
	}
	r
}

## Round.
pub round :: fn(x: float) float {
	if x < 0.0 { -floor(0.5 - x) } else { floor(x + 0.5) }
}

## Truncate.
pub trunc :: fn(x: float) int {
	int.(x)
}

## Linear interpolation.
pub lerp :: fn(from: float, to: float, by: float) float {
	from + (to - from) * by
}

## Length of the hypotenuse.
pub hypot :: fn(x: float, y: float) float {
	sqrt(x ** 2 + y ** 2)
}
