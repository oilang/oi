module math

# component-wise arithmetic and the length methods for vectors
# TODO: there's probably a better way to do this, i was having fun putting Oi's metaprogramming through its paces
vector! :: fn(input: Ast) Ast {
	n :: input.name
	adds: []Ast
	subs: []Ast
	muls: []Ast
	divs: []Ast
	scales: []Ast
	shrinks: []Ast
	negs: []Ast
	loop field in input.items {
		f :: field.name
		adds << `self.%f + o.%f`
		subs << `self.%f - o.%f`
		muls << `self.%f * o.%f`
		divs << `self.%f / o.%f`
		scales << `self.%f * s`
		shrinks << `self.%f / s`
		negs << `-self.%f`
	}
	dot := muls[0]
	loop m in muls[1..] { dot = `%dot + %m` }

	`
		%input
		%n[T] : Add < { add :: fn(self, o: Self) Self { .{ %{..adds} } } }
		%n[T] : Sub < { sub :: fn(self, o: Self) Self { .{ %{..subs} } } }
		%n[T] : Mul < { mul :: fn(self, o: Self) Self { .{ %{..muls} } } }
		%n[T] : Div < { div :: fn(self, o: Self) Self { .{ %{..divs} } } }
		%n[T] : Mul[T] < { mul :: fn(self; s: T) Self { .{ %{..scales} } } }
		%n[T] : Div[T] < { div :: fn(self; s: T) Self { .{ %{..shrinks} } } }
		%n[T] : Neg < { neg :: fn(self) Self { .{ %{..negs} } } }

		%n[T] :< {
			## Sum of the component-wise product.
			pub dot :: fn(self, o: Self) T { %dot }

			## Squared length, without the square root.
			pub length_squared :: fn(self) T { self.dot(self) }

			## Euclidean length.
			pub length :: fn(self) float { sqrt(self.dot(self)) }

			## Linear interpolation toward `to`.
			pub lerp :: fn(self, to: Self, by: T) Self { self + (to - self) * by }
		}

		%n[T: Float] :< {
			## Same direction, unit length.
			pub normalize :: fn(self) Self { self / T.(self.length()) }
		}
	`
}

## A 2D vector.
@vector!
pub Vec2[T :: float] :: struct { pub x: T, pub y: T }

## A 3D vector.
@vector!
pub Vec3[T :: float] :: struct { pub x: T, pub y: T, pub z: T }

## A 4D vector.
@vector!
pub Vec4[T :: float] :: struct { pub x: T, pub y: T, pub z: T, pub w: T }

Vec3[T] :< {
	## Perpendicular to both, by the right-hand rule.
	pub cross :: fn(self, o: Self) Self {
		.{
			self.y * o.z - self.z * o.y,
			self.z * o.x - self.x * o.z,
			self.x * o.y - self.y * o.x,
		}
	}
}
